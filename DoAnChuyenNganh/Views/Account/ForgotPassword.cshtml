@model DoAnChuyenNganh.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-card-header">
            <h2>Forgot Password?</h2>
            <p>Enter your email to reset your password</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-auth alert-auth-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert-auth alert-auth-error">
                <ul style="margin: 0; padding-left: 20px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="alert-auth alert-auth-info">
            Enter your email address and we'll send you a link to reset your password.
        </div>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="auth-form">
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email address" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth-primary">Send Reset Link</button>
        </form>

        <div class="auth-links">
            <a asp-action="Login" asp-controller="Account">Back to Login</a>
            <span class="separator">|</span>
            <a asp-action="Register" asp-controller="Account">Create Account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}

