@model DoAnChuyenNganh.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-card-header">
            <h2>Reset Password</h2>
            <p>Create a new password for your account</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-auth alert-auth-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert-auth alert-auth-error">
                <ul style="margin: 0; padding-left: 20px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="ResetPassword" asp-controller="Account" method="post" class="auth-form">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label>Email</label>
                <input type="text" class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" placeholder="Enter your new password" autocomplete="new-password" data-check-strength="true" />
                <div class="password-strength">
                    <div class="password-strength-bar"></div>
                </div>
                <div class="password-strength-text"></div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your new password" autocomplete="new-password" data-confirm-password="#Password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-auth-primary">Reset Password</button>
        </form>

        <div class="auth-links">
            <a asp-action="Login" asp-controller="Account">Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}

