@model DoAnChuyenNganh.ViewModels.Forum.ForumPostDetailViewModel
@{
    ViewData["Title"] = Model.Post.Title;
}

<link rel="stylesheet" href="~/css/forum.css" />

<div class="forum-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Forum")">Forum</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Category", "Forum", new { id = Model.CategoryId })">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Post.Title</li>
        </ol>
    </nav>

    <!-- Post Detail -->
    <div class="post-detail-card">
        <div class="post-header">
            <h1>
                @if (Model.Post.IsSticky)
                {
                    <i class="bi bi-pin-angle-fill text-warning" title="Sticky"></i>
                }
                @if (Model.Post.IsLocked)
                {
                    <i class="bi bi-lock-fill text-danger" title="Locked"></i>
                }
                @Model.Post.Title
            </h1>
            <div class="post-actions">
                @if (Model.Post.CanEdit)
                {
                    <a href="@Url.Action("EditPost", "Forum", new { id = Model.Post.PostId })" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                }
                @if (Model.Post.CanDelete)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deletePost(@Model.Post.PostId)">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                }
                @if (Model.Post.CanModerate)
                {
                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="toggleSticky(@Model.Post.PostId)">
                        <i class="bi bi-pin-angle"></i> @(Model.Post.IsSticky ? "Unpin" : "Pin")
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="toggleLock(@Model.Post.PostId)">
                        <i class="bi bi-lock"></i> @(Model.Post.IsLocked ? "Unlock" : "Lock")
                    </button>
                }
            </div>
        </div>

        <div class="post-author-info">
            <div class="author-avatar">
                @if (!string.IsNullOrEmpty(Model.Post.UserAvatarUrl))
                {
                    <img src="@Model.Post.UserAvatarUrl" alt="@Model.Post.Username" />
                }
                else
                {
                    <div class="avatar-placeholder-large">
                        <i class="bi bi-person-circle"></i>
                    </div>
                }
            </div>
            <div class="author-details">
                <h4><a href="@Url.Action("UserActivity", "Forum", new { id = Model.Post.UserId })">@Model.Post.Username</a></h4>
                <p class="text-muted">Posted on @Model.Post.CreatedAt?.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
                @if (Model.Post.UpdatedAt.HasValue && Model.Post.CreatedAt.HasValue &&
                     (Model.Post.UpdatedAt.Value - Model.Post.CreatedAt.Value).TotalSeconds > 5)
                {
                    <p class="text-muted"><small>Last edited: @Model.Post.UpdatedAt?.ToString("MMM dd, yyyy HH:mm")</small></p>
                }
            </div>
        </div>

        <div class="post-content-body">
            @Html.Raw(Model.Post.Content.Replace("\n", "<br />"))

            @* Display post attachments *@
            @if (Model.Post.Attachments != null && Model.Post.Attachments.Any())
            {
                <div class="post-attachments mt-3">
                    @* Display images in gallery *@
                    @{
                        var imageAttachments = Model.Post.Attachments.Where(a => a.FileType == "image").ToList();
                    }
                    @if (imageAttachments.Any())
                    {
                        <div class="image-gallery" data-gallery-id="post-@Model.Post.PostId">
                            <div class="gallery-container">
                                @for (int i = 0; i < imageAttachments.Count; i++)
                                {
                                    <div class="gallery-slide @(i == 0 ? "active" : "")" data-slide-index="@i">
                                        <img src="@imageAttachments[i].FilePath" alt="@imageAttachments[i].OriginalFileName" class="gallery-image" />
                                    </div>
                                }
                            </div>

                            @if (imageAttachments.Count > 1)
                            {
                                <button class="gallery-nav gallery-prev" onclick="navigateGallery('post-@Model.Post.PostId', -1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button class="gallery-nav gallery-next" onclick="navigateGallery('post-@Model.Post.PostId', 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <div class="gallery-counter">
                                    <span class="current-slide">1</span> / <span class="total-slides">@imageAttachments.Count</span>
                                </div>
                            }
                        </div>
                    }

                    @* Display files *@
                    @if (Model.Post.Attachments.Any(a => a.FileType == "file"))
                    {
                        <div class="attachment-files mt-2">
                            <h6><i class="bi bi-paperclip"></i> Attached Files:</h6>
                            @foreach (var attachment in Model.Post.Attachments.Where(a => a.FileType == "file"))
                            {
                                <div class="attachment-file-item">
                                    <a href="@attachment.FilePath" download="@attachment.OriginalFileName" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-download"></i> @attachment.OriginalFileName
                                        <span class="text-muted">(@attachment.FileSizeFormatted)</span>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="post-footer">
            <div class="post-stats-detail">
                <span><i class="bi bi-eye"></i> @Model.Post.ViewCount views</span>
                <span><i class="bi bi-chat-left-text"></i> @Model.Post.ReplyCount replies</span>
                <span><i class="bi bi-heart-fill"></i> @Model.Post.LikeCount likes</span>
            </div>
            <div class="post-actions-buttons">
                <button type="button" class="btn btn-sm @(Model.Post.IsLikedByCurrentUser ? "btn-danger" : "btn-outline-danger")" 
                        onclick="likePost(@Model.Post.PostId)" id="like-post-btn">
                    <i class="bi bi-heart-fill"></i> <span id="like-count">@Model.Post.LikeCount</span>
                </button>
                <button type="button" class="btn btn-sm @(Model.Post.IsBookmarkedByCurrentUser ? "btn-warning" : "btn-outline-warning")" 
                        onclick="bookmarkPost(@Model.Post.PostId, '@Model.Post.Title')" id="bookmark-post-btn">
                    <i class="bi bi-bookmark-fill"></i> @(Model.Post.IsBookmarkedByCurrentUser ? "Bookmarked" : "Bookmark")
                </button>
            </div>
        </div>
    </div>

    <!-- Replies Section -->
    <div class="replies-section">
        <h3><i class="bi bi-chat-dots"></i> Replies (@Model.Post.ReplyCount)</h3>

        @if (!Model.Post.IsLocked)
        {
            <!-- Reply Form -->
            <div class="reply-form-container">
                <h4>Post a Reply</h4>
                <form id="reply-form" asp-action="CreateReply" asp-controller="Forum" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PostId" value="@Model.Post.PostId" />
                    <input type="hidden" name="ParentReplyId" id="parent-reply-id" />

                    <div class="mb-3">
                        <label for="reply-content" class="form-label">Your Reply</label>
                        <textarea class="form-control" id="reply-content" name="Content" rows="5"></textarea>
                        <div id="reply-to-info" class="alert alert-info mt-2" style="display: none;">
                            Replying to <strong id="reply-to-username"></strong>
                            <button type="button" class="btn-close float-end" onclick="cancelReplyTo()"></button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload Images (Optional)</label>
                        <div class="drag-drop-zone drag-drop-zone-small" id="reply-image-drop-zone">
                            <div class="drag-drop-content">
                                <i class="bi bi-cloud-upload drag-drop-icon-small"></i>
                                <p class="drag-drop-text-small">Drag images or click to browse</p>
                                <input type="file" name="UploadedImages" class="form-control drag-drop-input" multiple
                                       accept=".jpg,.jpeg,.png,.gif,.webp" id="reply-image-upload" />
                            </div>
                        </div>
                        <small class="form-text text-muted">Max 5MB per image</small>
                        <div id="reply-image-preview" class="mt-2"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload Files (Optional)</label>
                        <div class="drag-drop-zone drag-drop-zone-small" id="reply-file-drop-zone">
                            <div class="drag-drop-content">
                                <i class="bi bi-file-earmark-arrow-up drag-drop-icon-small"></i>
                                <p class="drag-drop-text-small">Drag files or click to browse</p>
                                <input type="file" name="UploadedFiles" class="form-control drag-drop-input" multiple
                                       accept=".pdf,.doc,.docx,.zip,.rar" id="reply-file-upload" />
                            </div>
                        </div>
                        <small class="form-text text-muted">Max 10MB per file</small>
                        <div id="reply-file-preview" class="mt-2"></div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i> Post Reply
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="bi bi-lock-fill"></i> This post is locked. No new replies can be added.
            </div>
        }

        <!-- Replies List -->
        <div class="replies-list">
            @if (Model.Replies.Any())
            {
                @foreach (var reply in Model.Replies)
                {
                    @await Html.PartialAsync("_ReplyPartial", reply)
                }

                <!-- Pagination -->
                @if (Model.Pagination.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @if (Model.Pagination.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Post", new { id = Model.Post.PostId, page = Model.Pagination.CurrentPage - 1 })">
                                        Previous
                                    </a>
                                </li>
                            }

                            @foreach (var pageNum in Model.Pagination.GetPageNumbers())
                            {
                                <li class="page-item @(pageNum == Model.Pagination.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Post", new { id = Model.Post.PostId, page = pageNum })">
                                        @pageNum
                                    </a>
                                </li>
                            }

                            @if (Model.Pagination.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Post", new { id = Model.Post.PostId, page = Model.Pagination.CurrentPage + 1 })">
                                        Next
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No replies yet. Be the first to reply!
                </div>
            }
        </div>
    </div>

    <!-- Related Posts Sidebar -->
    @if (Model.RelatedPosts.Any())
    {
        <div class="related-posts-section">
            <h4><i class="bi bi-link-45deg"></i> Related Posts</h4>
            <div class="related-posts-list">
                @foreach (var relatedPost in Model.RelatedPosts)
                {
                    <div class="related-post-item">
                        <a href="@Url.Action("Post", "Forum", new { id = relatedPost.PostId })">
                            @relatedPost.Title
                        </a>
                        <small class="text-muted">
                            <i class="bi bi-chat-left-text"></i> @relatedPost.ReplyCount
                            <i class="bi bi-heart-fill ms-2"></i> @relatedPost.LikeCount
                        </small>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/tinymce/js/tinymce/tinymce.min.js"></script>
    <script src="~/js/forum.js"></script>
    <script>
        // Initialize TinyMCE for reply form
        tinymce.init({
            selector: '#reply-content',
            height: 300,
            menubar: false,
            license_key: 'gpl',
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'charmap',
                'searchreplace', 'visualblocks', 'code',
                'insertdatetime', 'table', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | ' +
                'bold italic underline | bullist numlist | ' +
                'link code | removeformat',
            content_style: 'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 14px }',
            branding: false,
            promotion: false
        });

        // Initialize reply form
        document.getElementById('reply-form').addEventListener('submit', async function(e) {
            e.preventDefault();

            try {
                // Get content from TinyMCE and validate
                let content = '';
                if (typeof tinymce !== 'undefined' && tinymce.get('reply-content')) {
                    content = tinymce.get('reply-content').getContent();
                    // Update textarea value
                    document.getElementById('reply-content').value = content;
                } else {
                    content = document.getElementById('reply-content').value;
                }

                // Validate content
                if (!content || content.trim() === '' || content === '<p><br></p>' || content === '<p></p>') {
                    alert('Please enter your reply content');
                    return;
                }

                const formData = new FormData(this);

                // Debug: Log form data
                console.log('Submitting reply form...');
                console.log('PostId:', formData.get('PostId'));
                console.log('Content:', formData.get('Content'));
                console.log('ParentReplyId:', formData.get('ParentReplyId'));

                const response = await fetch(this.action, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();
                console.log('Reply result:', result);

                if (result.success) {
                    alert(result.message);
                    location.reload();
                } else {
                    alert(result.message || 'Failed to post reply');
                }
            } catch (error) {
                console.error('Error submitting reply:', error);
                alert('An error occurred while posting your reply. Please try again.');
            }
        });

        function replyTo(replyId, username) {
            document.getElementById('parent-reply-id').value = replyId;
            document.getElementById('reply-to-username').textContent = username;
            document.getElementById('reply-to-info').style.display = 'block';

            // Focus TinyMCE editor
            if (typeof tinymce !== 'undefined' && tinymce.get('reply-content')) {
                tinymce.get('reply-content').focus();
            } else {
                document.getElementById('reply-content').focus();
            }
        }

        function cancelReplyTo() {
            document.getElementById('parent-reply-id').value = '';
            document.getElementById('reply-to-info').style.display = 'none';
        }
    </script>
}

