@model DoAnChuyenNganh.ViewModels.Forum.ForumPostViewModel
@{
    ViewData["Title"] = "Create New Post";
}

<link rel="stylesheet" href="~/css/forum.css" />

<div class="forum-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Forum")">Forum</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create New Post</li>
        </ol>
    </nav>

    <div class="form-container">
        <h1><i class="bi bi-plus-circle"></i> Create New Post</h1>

        <form asp-action="CreatePost" asp-controller="Forum" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Category *</label>
                <select asp-for="CategoryId" class="form-select" required>
                    <option value="">-- Select a Category --</option>
                    @foreach (var category in ViewBag.Categories as List<DoAnChuyenNganh.ViewModels.Forum.ForumCategoryViewModel>)
                    {
                        <option value="@category.CategoryId" selected="@(category.CategoryId == Model.CategoryId)">
                            @category.CategoryName
                        </option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title *</label>
                <input asp-for="Title" class="form-control" placeholder="Enter a descriptive title for your post" required />
                <span asp-validation-for="Title" class="text-danger"></span>
                <small class="form-text text-muted">
                    A clear, descriptive title helps others find and understand your post.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label">Content *</label>

                <!-- Preview/Edit Toggle Buttons -->
                <div class="btn-group mb-2" role="group">
                    <button type="button" class="btn btn-sm btn-outline-primary active" id="edit-tab-btn" onclick="switchToEditMode()">
                        <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="preview-tab-btn" onclick="switchToPreviewMode()">
                        <i class="bi bi-eye"></i> Preview
                    </button>
                </div>

                <!-- Edit Mode -->
                <div id="edit-mode">
                    <textarea asp-for="Content" class="form-control" id="post-content" rows="15"
                              placeholder="Write your post content here..." required></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                    <small class="form-text text-muted">
                        Be clear and provide as much detail as possible. You can use line breaks for formatting.
                    </small>
                </div>

                <!-- Preview Mode -->
                <div id="preview-mode" style="display: none;">
                    <div class="post-preview-container">
                        <h4 id="preview-title" class="preview-title"></h4>
                        <div id="preview-content" class="preview-content"></div>
                        <div id="preview-images" class="preview-images"></div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Upload Images (Optional)</label>
                <input type="file" name="UploadedImages" class="form-control" multiple
                       accept=".jpg,.jpeg,.png,.gif,.webp" id="image-upload" />
                <small class="form-text text-muted">
                    Allowed formats: JPG, PNG, GIF, WebP. Max 5MB per image. You can select multiple images.
                </small>
                <div id="image-preview" class="mt-2"></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Upload Files (Optional)</label>
                <input type="file" name="UploadedFiles" class="form-control" multiple
                       accept=".pdf,.doc,.docx,.zip,.rar" id="file-upload" />
                <small class="form-text text-muted">
                    Allowed formats: PDF, DOC, DOCX, ZIP, RAR. Max 10MB per file. You can select multiple files.
                </small>
                <div id="file-preview" class="mt-2"></div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send"></i> Create Post
                </button>
                <a href="@Url.Action("Index", "Forum")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>

        <!-- Posting Guidelines -->
        <div class="posting-guidelines mt-4">
            <h4><i class="bi bi-info-circle"></i> Posting Guidelines</h4>
            <ul>
                <li>Be respectful and courteous to other members</li>
                <li>Stay on topic and post in the appropriate category</li>
                <li>Use clear and descriptive titles</li>
                <li>Provide detailed information in your post</li>
                <li>Search before posting to avoid duplicates</li>
                <li>Follow community rules and guidelines</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/forum.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

