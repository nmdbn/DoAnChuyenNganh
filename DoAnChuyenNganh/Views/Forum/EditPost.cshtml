@model DoAnChuyenNganh.ViewModels.Forum.ForumPostViewModel
@{
    ViewData["Title"] = "Edit Post";
}

<link rel="stylesheet" href="~/css/forum.css" />

<div class="forum-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Forum")">Forum</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Post", "Forum", new { id = Model.PostId })">@Model.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="form-container">
        <h1><i class="bi bi-pencil"></i> Edit Post</h1>

        <form asp-action="EditPost" asp-controller="Forum" asp-route-id="@Model.PostId" method="post" enctype="multipart/form-data" id="edit-post-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- Upload Progress Overlay -->
            <div class="upload-progress-overlay" id="upload-progress-overlay" style="display: none;">
                <div class="upload-progress-content">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Uploading...</span>
                    </div>
                    <h5 class="mt-3">Uploading files...</h5>
                    <div class="progress mt-3" style="width: 300px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             id="upload-progress-bar"
                             style="width: 0%">0%</div>
                    </div>
                    <p class="mt-2 text-muted" id="upload-status">Preparing upload...</p>
                </div>
            </div>

            <input type="hidden" asp-for="PostId" />
            <input type="hidden" asp-for="UserId" />

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Category *</label>
                <select asp-for="CategoryId" class="form-select" required>
                    @foreach (var category in ViewBag.Categories as List<DoAnChuyenNganh.ViewModels.Forum.ForumCategoryViewModel>)
                    {
                        <option value="@category.CategoryId" selected="@(category.CategoryId == Model.CategoryId)">
                            @category.CategoryName
                        </option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title *</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label">Content *</label>

                <!-- Preview/Edit Toggle Buttons -->
                <div class="btn-group mb-2" role="group">
                    <button type="button" class="btn btn-sm btn-outline-primary active" id="edit-tab-btn" onclick="switchToEditMode()">
                        <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="preview-tab-btn" onclick="switchToPreviewMode()">
                        <i class="bi bi-eye"></i> Preview
                    </button>
                </div>

                <!-- Edit Mode -->
                <div id="edit-mode">
                    <textarea asp-for="Content" class="form-control" id="post-content" rows="15" required></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <!-- Preview Mode -->
                <div id="preview-mode" style="display: none;">
                    <div class="post-preview-container">
                        <h4 id="preview-title" class="preview-title"></h4>
                        <div id="preview-content" class="preview-content"></div>
                        <div id="preview-images" class="preview-images"></div>
                    </div>
                </div>
            </div>

            @if (Model.Attachments != null && Model.Attachments.Any())
            {
                <div class="mb-3">
                    <label class="form-label">Existing Attachments</label>
                    <div class="existing-attachments">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="attachment-item" id="attachment-@attachment.AttachmentId">
                                @if (attachment.FileType == "image")
                                {
                                    <img src="@attachment.FilePath" alt="@attachment.OriginalFileName" class="attachment-thumbnail" />
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark"></i>
                                }
                                <span>@attachment.OriginalFileName (@attachment.FileSizeFormatted)</span>
                                <button type="button" class="btn btn-sm btn-danger delete-attachment-btn"
                                        onclick="deleteAttachment(@attachment.AttachmentId)"
                                        title="Delete attachment">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Upload Additional Images (Optional)</label>
                <div class="drag-drop-zone" id="image-drop-zone">
                    <div class="drag-drop-content">
                        <i class="bi bi-cloud-upload drag-drop-icon"></i>
                        <p class="drag-drop-text">Drag and drop images here or click to browse</p>
                        <input type="file" name="UploadedImages" class="form-control drag-drop-input" multiple
                               accept=".jpg,.jpeg,.png,.gif,.webp" id="image-upload" />
                    </div>
                </div>
                <small class="form-text text-muted">
                    Allowed formats: JPG, PNG, GIF, WebP. Max 5MB per image.
                </small>
                <div id="image-preview" class="mt-2"></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Upload Additional Files (Optional)</label>
                <div class="drag-drop-zone" id="file-drop-zone">
                    <div class="drag-drop-content">
                        <i class="bi bi-file-earmark-arrow-up drag-drop-icon"></i>
                        <p class="drag-drop-text">Drag and drop files here or click to browse</p>
                        <input type="file" name="UploadedFiles" class="form-control drag-drop-input" multiple
                               accept=".pdf,.doc,.docx,.zip,.rar" id="file-upload" />
                    </div>
                </div>
                <small class="form-text text-muted">
                    Allowed formats: PDF, DOC, DOCX, ZIP, RAR. Max 10MB per file.
                </small>
                <div id="file-preview" class="mt-2"></div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check"></i> Save Changes
                </button>
                <a href="@Url.Action("Post", "Forum", new { id = Model.PostId })" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/tinymce/js/tinymce/tinymce.min.js"></script>
    <script src="~/js/forum.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Initialize TinyMCE
        tinymce.init({
            selector: '#post-content',
            height: 400,
            menubar: false,
            license_key: 'gpl',
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'charmap', 'preview',
                'searchreplace', 'visualblocks', 'code', 'fullscreen',
                'insertdatetime', 'table', 'help', 'wordcount'
            ],
            toolbar: 'undo redo | blocks | ' +
                'bold italic underline strikethrough | alignleft aligncenter ' +
                'alignright alignjustify | bullist numlist outdent indent | ' +
                'link code | removeformat | help',
            content_style: 'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 14px }',
            branding: false,
            promotion: false
        });

        // Sync TinyMCE content before form submission
        document.getElementById('edit-post-form').addEventListener('submit', function(e) {
            if (typeof tinymce !== 'undefined' && tinymce.get('post-content')) {
                tinymce.get('post-content').save();
            }
        });
    </script>
}

