@model DoAnChuyenNganh.ViewModels.Forum.ForumSearchViewModel
@{
    ViewData["Title"] = "Search Forum";
}

<link rel="stylesheet" href="~/css/forum.css" />

<div class="forum-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Forum")">Forum</a></li>
            <li class="breadcrumb-item active" aria-current="page">Search</li>
        </ol>
    </nav>

    <div class="search-container">
        <h1><i class="bi bi-search"></i> Search Forum</h1>

        <!-- Search Form -->
        <form asp-action="Search" asp-controller="Forum" method="get" class="search-form">
            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Query" class="form-label">Search Query</label>
                        <input asp-for="Query" class="form-control form-control-lg" placeholder="Enter keywords..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label">Category</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">All Categories</option>
                            @foreach (var category in ViewBag.Categories as List<DoAnChuyenNganh.ViewModels.Forum.ForumCategoryViewModel>)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3">
                        <label asp-for="SearchIn" class="form-label">Search In</label>
                        <select asp-for="SearchIn" class="form-select">
                            <option value="all">Titles and Content</option>
                            <option value="titles">Titles Only</option>
                            <option value="content">Content Only</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label asp-for="SortBy" class="form-label">Sort By</label>
                        <select asp-for="SortBy" class="form-select">
                            <option value="relevance">Relevance</option>
                            <option value="date">Date</option>
                            <option value="replies">Most Replies</option>
                            <option value="likes">Most Likes</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label asp-for="DateFrom" class="form-label">Date From</label>
                        <input asp-for="DateFrom" type="date" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label asp-for="DateTo" class="form-label">Date To</label>
                        <input asp-for="DateTo" type="date" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Author" class="form-label">Author</label>
                <input asp-for="Author" class="form-control" placeholder="Filter by author username" />
            </div>

            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-search"></i> Search
            </button>
            <a href="@Url.Action("Search", "Forum")" class="btn btn-secondary btn-lg">
                <i class="bi bi-x-circle"></i> Clear
            </a>
        </form>

        <!-- Search Results -->
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="search-results mt-4">
                <h3>
                    Search Results
                    @if (Model.TotalResults > 0)
                    {
                        <span class="badge bg-primary">@Model.TotalResults results found</span>
                    }
                </h3>

                @if (Model.Results.Any())
                {
                    <div class="posts-list">
                        @foreach (var post in Model.Results)
                        {
                            <div class="post-card">
                                <div class="post-avatar">
                                    @if (!string.IsNullOrEmpty(post.UserAvatarUrl))
                                    {
                                        <img src="@post.UserAvatarUrl" alt="@post.Username" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder">
                                            <i class="bi bi-person-circle"></i>
                                        </div>
                                    }
                                </div>
                                <div class="post-content">
                                    <div class="post-title-row">
                                        <h4>
                                            <a href="@Url.Action("Post", "Forum", new { id = post.PostId })">
                                                @post.Title
                                            </a>
                                        </h4>
                                        <span class="badge bg-secondary">@post.CategoryName</span>
                                    </div>
                                    <div class="post-excerpt">
                                        @{
                                            var excerpt = post.Content.Length > 200 ? post.Content.Substring(0, 200) + "..." : post.Content;
                                        }
                                        @excerpt
                                    </div>
                                    <div class="post-meta">
                                        <span class="post-author">
                                            <i class="bi bi-person"></i>
                                            <a href="@Url.Action("UserActivity", "Forum", new { id = post.UserId })">@post.Username</a>
                                        </span>
                                        <span class="post-date">
                                            <i class="bi bi-clock"></i>
                                            @post.CreatedAt?.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>
                                </div>
                                <div class="post-stats">
                                    <div class="stat-item">
                                        <i class="bi bi-eye"></i>
                                        <span>@post.ViewCount</span>
                                    </div>
                                    <div class="stat-item">
                                        <i class="bi bi-chat-left-text"></i>
                                        <span>@post.ReplyCount</span>
                                    </div>
                                    <div class="stat-item">
                                        <i class="bi bi-heart-fill"></i>
                                        <span>@post.LikeCount</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (Model.Pagination.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation" class="mt-4">
                            <ul class="pagination justify-content-center">
                                @if (Model.Pagination.HasPreviousPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Search", new { 
                                            query = Model.Query, 
                                            categoryId = Model.CategoryId, 
                                            author = Model.Author,
                                            searchIn = Model.SearchIn,
                                            sortBy = Model.SortBy,
                                            dateFrom = Model.DateFrom,
                                            dateTo = Model.DateTo,
                                            page = Model.Pagination.CurrentPage - 1 
                                        })">
                                            Previous
                                        </a>
                                    </li>
                                }

                                @foreach (var pageNum in Model.Pagination.GetPageNumbers())
                                {
                                    <li class="page-item @(pageNum == Model.Pagination.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Search", new { 
                                            query = Model.Query, 
                                            categoryId = Model.CategoryId, 
                                            author = Model.Author,
                                            searchIn = Model.SearchIn,
                                            sortBy = Model.SortBy,
                                            dateFrom = Model.DateFrom,
                                            dateTo = Model.DateTo,
                                            page = pageNum 
                                        })">
                                            @pageNum
                                        </a>
                                    </li>
                                }

                                @if (Model.Pagination.HasNextPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Search", new { 
                                            query = Model.Query, 
                                            categoryId = Model.CategoryId, 
                                            author = Model.Author,
                                            searchIn = Model.SearchIn,
                                            sortBy = Model.SortBy,
                                            dateFrom = Model.DateFrom,
                                            dateTo = Model.DateTo,
                                            page = Model.Pagination.CurrentPage + 1 
                                        })">
                                            Next
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> No results found for your search query. Try different keywords or filters.
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/forum.js"></script>
}

