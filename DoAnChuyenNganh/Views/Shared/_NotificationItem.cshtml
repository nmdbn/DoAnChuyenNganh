@model DoAnChuyenNganh.ViewModels.Notification.NotificationViewModel

<div class="notification-item @(Model.IsRead ? "read" : "unread")" data-notification-id="@Model.NotificationId">
    <div class="notification-icon">
        <i class="@Model.Icon @Model.IconColor"></i>
    </div>
    <div class="notification-content">
        <div class="notification-header">
            <span class="notification-title">@Model.Title</span>
            <span class="notification-time">@Model.TimeAgo</span>
        </div>
        <div class="notification-message">@Model.Message</div>
        @if (!string.IsNullOrEmpty(Model.Url))
        {
            <a href="@Model.Url" class="notification-link stretched-link"></a>
        }
    </div>
    <div class="notification-actions">
        @if (!Model.IsRead)
        {
            <button type="button" class="btn btn-sm btn-link mark-as-read-btn" 
                    data-notification-id="@Model.NotificationId" 
                    title="Mark as read">
                <i class="bi bi-check2"></i>
            </button>
        }
        <button type="button" class="btn btn-sm btn-link delete-notification-btn" 
                data-notification-id="@Model.NotificationId" 
                title="Delete">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
</div>

