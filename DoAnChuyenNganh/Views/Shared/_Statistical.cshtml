@model DoAnChuyenNganh.ViewModels.Statistical.StatisticalViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "_Statistical";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2><i class="bi bi-bar-chart"></i> System Statistics</h2>
                <p class="text-muted mb-0">Overview of Courses, Lessons, Users, Subjects and Grades</p>
            </div>
        </div>
    </div>

    <!-- SUMMARY CHART -->
    <div class="row mt-4">
        <!-- Doanh thu theo thời gian -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    Revenue over time
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Số khóa học bán theo thời gian -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    Number of courses sold by time
                </div>
                <div class="card-body">
                    <canvas id="salesChart" style="height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> Summary Statistics</h5>
            <small class="text-white-50">Click a bar or a button to view details</small>
        </div>
        <div class="card-body">
            <div style="height: 260px;">
                <canvas id="statsChart"></canvas>
            </div>

            <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                <div class="btn-group flex-wrap" role="group" aria-label="Data sections">
                    <button type="button" class="btn btn-outline-primary btn-sm" data-target="section-courses">
                        Courses
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-target="section-lessons">
                        Lessons
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-target="section-users">
                        Users
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-target="section-subjects">
                        Subjects
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-target="section-grades">
                        Grades
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- COURSES TABLE -->
    <div id="section-courses" class="data-section d-none">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-journal-bookmark"></i> Courses</h5>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Grade</th>
                            <th>Difficulty</th>
                            <th>Price</th>
                            <th>Published</th>
                            <th>Created At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Courses.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No courses found.</td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;
                            foreach (var c in Model.Courses)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@c.Title</td>
                                    <td>@c.Subject?.SubjectName</td>
                                    <td>@c.Grade?.GradeName</td>
                                    <td>@c.DifficultyLevel</td>
                                    <td>@string.Format("{0:0,0}", c.Price)</td>
                                    <td>
                                        @if (c.IsPublished == true)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>@c.CreatedAt?.ToString("yyyy-MM-dd")</td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- LESSONS TABLE -->
    <div id="section-lessons" class="data-section d-none">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-collection-play"></i> Lessons</h5>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Title</th>
                            <th>Order</th>
                            <th>Type</th>
                            <th>Published</th>
                            <th>Previewable</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Lessons.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">No lessons found.</td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;
                            foreach (var l in Model.Lessons)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@l.Course?.Title</td>
                                    <td>@l.Title</td>
                                    <td>@l.LessonOrder</td>
                                    <td>@l.LessonType</td>
                                    <td>
                                        @if (l.IsPublished == true)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (l.IsPreviewable == true)
                                        {
                                            <span class="badge bg-info text-dark">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">No</span>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- USERS TABLE -->
    <div id="section-users" class="data-section d-none">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-people"></i> Users</h5>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Active</th>
                            <th>Email Verified</th>
                            <th>Created At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Users.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">No users found.</td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;
                            foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@u.Username</td>
                                    <td>@($"{u.FirstName} {u.LastName}")</td>
                                    <td>@u.Email</td>
                                    <td>
                                        @if (u.IsActive == true)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsEmailVerified == true)
                                        {
                                            <span class="badge bg-info text-dark">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">No</span>
                                        }
                                    </td>
                                    <td>@u.CreatedAt?.ToString("yyyy-MM-dd")</td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SUBJECTS TABLE -->
    <div id="section-subjects" class="data-section d-none">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-book-half"></i> Subjects</h5>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Subject Name</th>
                            <th>Code</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Subjects.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No subjects found.</td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;
                            foreach (var s in Model.Subjects)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@s.SubjectName</td>
                                    <td>@s.SubjectCode</td>
                                    <td>
                                        @if (s.IsActive == true)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- GRADES TABLE -->
    <div id="section-grades" class="data-section d-none">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-layers"></i> Grades</h5>
            </div>
            <div class="card-body table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Grade Name</th>
                            <th>Level</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Grades.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No grades found.</td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;
                            foreach (var g in Model.Grades)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@g.GradeName</td>
                                    <td>@g.GradeLevel</td>
                                    <td>
                                        @if (g.IsActive == true)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ===== KHAI BÁO DỮ LIỆU TRƯỚC =====
        const revenueLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue?.Select(m => m.Month) ?? new List<string>()));
        const revenueData = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue?.Select(m => m.Revenue) ?? new List<decimal>()));
        const salesLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales?.Select(m => m.Month) ?? new List<string>()));
        const salesData = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales?.Select(m => m.SalesCount) ?? new List<int>()));

        // Debug
        console.log('=== DEBUG CHART DATA ===');
        console.log('Revenue Labels:', revenueLabels);
        console.log('Revenue Data:', revenueData);
        console.log('Sales Labels:', salesLabels);
        console.log('Sales Data:', salesData);

        // Kiểm tra nếu không có dữ liệu
        if (!revenueLabels || revenueLabels.length === 0) {
            console.warn('⚠️ No data available revenue');
        }
        if (!salesLabels || salesLabels.length === 0) {
            console.warn('⚠️ No data available sales');
        }

        // ===== VẼ BIỂU ĐỒ CHỈ KHI CÓ DỮ LIỆU =====
        const canvasRevenue = document.getElementById('revenueChart');
        const canvasSales = document.getElementById('salesChart');

        if (canvasRevenue) {
            const ctxRevenue = canvasRevenue.getContext('2d');
            const revenueChart = new Chart(ctxRevenue, {
                type: 'line', // Đổi sang line để dễ nhìn hơn
                data: {
                    labels: revenueLabels,
                    datasets: [{
                        label: 'Revenue (VNĐ)',
                        data: revenueData,
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const value = context.raw || 0;
                                    return ' ' + value.toLocaleString('vi-VN') + ' VNĐ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return value.toLocaleString('vi-VN');
                                }
                            }
                        }
                    }
                }
            });
        } else {
            console.error('❌ Not found canvas revenueChart');
        }

        if (canvasSales) {
            const ctxSales = canvasSales.getContext('2d');
            const salesChart = new Chart(ctxSales, {
                type: 'bar',
                data: {
                    labels: salesLabels,
                    datasets: [{
                        label: 'Number of courses sold',
                        data: salesData,
                        backgroundColor: 'rgba(75, 192, 192, 0.6)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        } else {
            console.error('❌ Not found canvas salesChart');
        }

        // ===== BIỂU ĐỒ TỔNG QUAN =====
        function showSection(sectionId) {
            const sections = document.querySelectorAll('.data-section');
            sections.forEach(s => s.classList.add('d-none'));

            if (sectionId) {
                const target = document.getElementById(sectionId);
                if (target) {
                    target.classList.remove('d-none');
                }
            }

            const btns = document.querySelectorAll('[data-target]');
            btns.forEach(btn => {
                if (btn.getAttribute('data-target') === sectionId) {
                    btn.classList.add('btn-primary');
                    btn.classList.remove('btn-outline-primary');
                } else {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-outline-primary');
                }
            });
        }

        (function () {
            const labels = ['Courses', 'Lessons', 'Users', 'Subjects', 'Grades'];
            const data = [
        @Model.TotalCourses,
        @Model.TotalLessons,
        @Model.TotalUsers,
        @Model.TotalSubjects,
        @Model.TotalGrades
            ];

            const ctx = document.getElementById('statsChart').getContext('2d');
            const statsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total Count',
                        data: data,
                        backgroundColor: [
                            '#4e79a7',
                            '#f28e2b',
                            '#e15759',
                            '#76b7b2',
                            '#59a14f'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    onClick: (evt, elements) => {
                        if (!elements.length) return;
                        const index = elements[0].index;
                        const mapping = [
                            'section-courses',
                            'section-lessons',
                            'section-users',
                            'section-subjects',
                            'section-grades'
                        ];
                        showSection(mapping[index]);
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 },
                            title: {
                                display: true,
                                text: 'Number of Records'
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => ' ' + ctx.parsed.y
                            }
                        }
                    }
                }
            });

            document.querySelectorAll('[data-target]').forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    showSection(targetId);
                });
            });

            showSection(null);
        })();
    </script>
}