<!DOCTYPE html>
@{
    var roleName = Context.Session.GetString("RoleName");

    bool isLoggedIn = !string.IsNullOrEmpty(roleName);
    bool isAdmin = string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase);
    bool isInstructor = string.Equals(roleName, "Instructor", StringComparison.OrdinalIgnoreCase);
    bool isUser = string.Equals(roleName, "User", StringComparison.OrdinalIgnoreCase);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoAnChuyenNganh</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAnChuyenNganh.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DoAnChuyenNganh</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Forum" asp-action="Index">
                                <i class="bi bi-chat-dots"></i> Forum
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Forum" asp-action="Search">
                                <i class="bi bi-search"></i> Search
                            </a>
                        </li>
                        @if (Context.Session.GetInt32("UserId").HasValue)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark position-relative" asp-area="" asp-controller="Chat" asp-action="Index">
                                    <i class="bi bi-chat-dots"></i> Messages
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                          id="chatUnreadBadge" style="display: none;">
                                        0
                                    </span>
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (isLoggedIn)   // chỉ khi đã login mới thấy nút Admin
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear"></i> Interact
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">

                                    @* ---- CHỈ ADMIN: User Management ---- *@
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="User" asp-action="Index">
                                                <i class="bi bi-people"></i> User Management
                                            </a>
                                        </li>
                                    }

                                    <li class="dropdown-submenu">
                                        <a class="dropdown-item dropdown-toggle" href="#" id="learningManagementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-book"></i> Learning Management
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="learningManagementDropdown">

                                            @* ---- ADMIN + INSTRUCTOR: Add Course ---- *@
                                            @if (isAdmin || isInstructor)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Course" asp-action="Create">
                                                        <i class="bi bi-plus-circle"></i> Add Course
                                                    </a>
                                                </li>
                                            }

                                            @* ---- ADMIN + INSTRUCTOR: Manage Lessons & Materials ---- *@
                                            @if (isAdmin || isInstructor)
                                            {
                                                <li class="dropdown-submenu">
                                                    <a class="dropdown-item dropdown-toggle" href="#" id="manageLessonsMaterialsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bi bi-file-earmark-text"></i> Manage Lessons & Materials
                                                    </a>
                                                    <ul class="dropdown-menu" aria-labelledby="manageLessonsMaterialsDropdown">
                                                        <li>
                                                            <a class="dropdown-item" asp-controller="Lesson" asp-action="Index">
                                                                <i class="bi bi-file-earmark-text"></i> Manage Lessons
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" asp-controller="CourseMaterial" asp-action="Index">
                                                                <i class="bi bi-file-earmark-text"></i> Manage Materials
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </li>
                                            }

                                            @* ---- ADMIN + INSTRUCTOR + USER: Khóa học ---- *@
                                            @if (isAdmin || isInstructor || isUser)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Course" asp-action="Public">
                                                        <i class="bi bi-collection"></i> Khóa học
                                                    </a>
                                                </li>
                                            }

                                            @* ---- CHỈ ADMIN: Subject + Grade ---- *@
                                            @if (isAdmin)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Subject" asp-action="Index">
                                                        <i class="bi bi-list-ul"></i> Manage Subjects
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Grades" asp-action="Index">
                                                        <i class="bi bi-list-ul"></i> Manage Grades
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </li>

                                    @* ---- CHỈ ADMIN: Statistics / System Administration ---- *@
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Dashboard" asp-action="_Statistical">
                                                <i class="bi bi-wrench"></i> System Administration
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav">
                        @if (Context.Session.GetInt32("UserId").HasValue)
                        {
                            var avatarUrl = Context.Session.GetString("AvatarUrl");
                            var username = Context.Session.GetString("Username");
                            var fullName = Context.Session.GetString("FullName");
                            string initials = "";

                            if (!string.IsNullOrWhiteSpace(fullName))
                            {
                                var names = fullName
                                .Trim()
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                if (names.Length >= 2)
                                {
                                    var first = names[0];
                                    var last = names[names.Length - 1];
                                    initials = (first.Length > 0 ? first[0].ToString() : "")
                                    + (last.Length > 0 ? last[0].ToString() : "");
                                }
                                else if (names.Length == 1 && names[0].Length > 0)
                                {
                                    initials = names[0][0].ToString();
                                }
                            }

                            <!-- Notification Bell -->
                            <li class="nav-item dropdown me-2">
                                <a class="nav-link position-relative" href="#" id="notificationDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                          id="notificationBadge" style="display: none;">
                                        0
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end notification-dropdown"
                                     aria-labelledby="notificationDropdown" id="notificationDropdownMenu">
                                    <div class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="@username" class="navbar-avatar" />
                                    }
                                    else
                                    {
                                        <div class="navbar-avatar-placeholder">
                                            @initials
                                        </div>
                                    }
                                    <span class="ms-2">@username</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person"></i> My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="bi bi-key"></i> Change Password
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                                            <button type="submit" class="dropdown-item" style="border: none; background: none; cursor: pointer; width: 100%; text-align: left;">
                                                <i class="bi bi-box-arrow-right"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    &copy; 2025 - DoAnChuyenNganh - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
                @if (Context.Session.GetInt32("UserId").HasValue)
                {
                    <div class="online-users-counter">
                        <i class="bi bi-circle-fill"></i>
                        <span id="onlineUsersCount">0</span> online
                    </div>
                }
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (Context.Session.GetInt32("UserId").HasValue)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.0/dist/browser/signalr.min.js"></script>
        <script src="~/js/notification.js" asp-append-version="true"></script>
        <script src="~/js/chat.js" asp-append-version="true"></script>
        <script>
            const globalUserId = @Context.Session.GetInt32("UserId");
            if (typeof NotificationManager !== 'undefined') {
                NotificationManager.init(globalUserId);
            }
            if (typeof ChatManager !== 'undefined') {
                ChatManager.init(globalUserId);
            }
        </script>
    }
    @if (TempData["SuccessMessage"]?.ToString() == "Login with Google successful!" || TempData["SuccessMessage"]?.ToString() == "Login with Facebook successful!")
    {
        <script>
            window.location.replace(window.location.href);
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .dropdown-submenu {
        position: relative;
    }

        .dropdown-submenu .dropdown-menu {
            top: 0;
            left: 100%;
            margin-top: -1px;
        }

        .dropdown-submenu:hover > .dropdown-menu {
            display: block;
        }
</style>
