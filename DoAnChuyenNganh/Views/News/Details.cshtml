@model DoAnChuyenNganh.ViewModels.News.NewsArticleDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="~/css/news.css" />

<div class="news-detail-container">
    <div class="container mt-4">
        <div class="row">
            <!-- Main Article Content -->
            <div class="col-lg-8">
                <article class="news-article">
                    <!-- Article Header -->
                    <div class="article-header">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "News")">News</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                            </ol>
                        </nav>

                        <span class="badge bg-primary mb-3">@Model.CategoryName</span>
                        @if (Model.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark mb-3">
                                <i class="bi bi-star-fill"></i> Featured
                            </span>
                        }

                        <h1 class="article-title">@Model.Title</h1>

                        <div class="article-meta-detail">
                            <div class="author-info">
                                @if (!string.IsNullOrEmpty(Model.AuthorAvatarUrl))
                                {
                                    <img src="@Model.AuthorAvatarUrl" alt="@Model.AuthorName" class="author-avatar">
                                }
                                else
                                {
                                    <div class="author-avatar-placeholder">
                                        <i class="bi bi-person-circle"></i>
                                    </div>
                                }
                                <div>
                                    <strong>@Model.AuthorName</strong>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar"></i> @Model.PublishedAt?.ToString("MMMM dd, yyyy")
                                        @if (Model.UpdatedAt.HasValue && Model.UpdatedAt > Model.PublishedAt)
                                        {
                                            <span class="ms-2">
                                                <i class="bi bi-pencil"></i> Updated: @Model.UpdatedAt?.ToString("MMM dd, yyyy")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="article-stats">
                                <span><i class="bi bi-eye"></i> @Model.ViewCount views</span>
                            </div>
                        </div>
                    </div>

                    <!-- Featured Image -->
                    @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
                    {
                        <div class="article-featured-image">
                            <img src="@Model.FeaturedImageUrl" alt="@Model.Title" class="img-fluid">
                        </div>
                    }

                    <!-- Article Content -->
                    <div class="article-content">
                        @Html.Raw(Model.Content)
                    </div>

                    <!-- Tags -->
                    @if (!string.IsNullOrEmpty(Model.Tags))
                    {
                        <div class="article-tags">
                            <i class="bi bi-tags"></i>
                            @foreach (var tag in Model.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-secondary">@tag.Trim()</span>
                            }
                        </div>
                    }

                    <!-- Share Buttons -->
                    <div class="article-share">
                        <h5>Share this article:</h5>
                        <div class="share-buttons">
                            <a href="https://www.facebook.com/sharer/sharer.php?u=@Url.Action("Details", "News", new { slug = Model.Slug }, Context.Request.Scheme)" 
                               target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-facebook"></i> Facebook
                            </a>
                            <a href="https://twitter.com/intent/tweet?url=@Url.Action("Details", "News", new { slug = Model.Slug }, Context.Request.Scheme)&text=@Model.Title" 
                               target="_blank" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-twitter"></i> Twitter
                            </a>
                            <button class="btn btn-outline-secondary btn-sm" onclick="copyToClipboard()">
                                <i class="bi bi-link-45deg"></i> Copy Link
                            </button>
                        </div>
                    </div>
                </article>

                <!-- Related Articles -->
                @if (Model.RelatedArticles != null && Model.RelatedArticles.Any())
                {
                    <div class="related-articles mt-5">
                        <h3><i class="bi bi-newspaper"></i> Related Articles</h3>
                        <div class="row">
                            @foreach (var article in Model.RelatedArticles)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="related-article-card">
                                        @if (!string.IsNullOrEmpty(article.FeaturedImageUrl))
                                        {
                                            <img src="@article.FeaturedImageUrl" alt="@article.Title" class="related-image">
                                        }
                                        <div class="related-content">
                                            <h5>
                                                <a href="@Url.Action("Details", "News", new { slug = article.Slug })">
                                                    @article.Title
                                                </a>
                                            </h5>
                                            <div class="article-meta-small">
                                                <span><i class="bi bi-calendar"></i> @article.PublishedAt?.ToString("MMM dd, yyyy")</span>
                                                <span><i class="bi bi-eye"></i> @article.ViewCount</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="sidebar-section">
                    <a href="@Url.Action("Index", "News")" class="btn btn-outline-primary w-100 mb-3">
                        <i class="bi bi-arrow-left"></i> Back to News
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard() {
        const url = window.location.href;
        navigator.clipboard.writeText(url).then(() => {
            alert('Link copied to clipboard!');
        });
    }
</script>

<script src="~/js/news.js"></script>

