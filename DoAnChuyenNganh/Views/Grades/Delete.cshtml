@model DoAnChuyenNganh.Models.Grade

@{
    ViewData["Title"] = "Delete Grade";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Helper functions
    string DateTimeOrDash(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    string TextOrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s!;
}

<div class="container py-3">
    <!-- HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1 text-danger">
                <i class="bi bi-trash"></i> Delete Grade
            </h2>
            <div class="text-muted">
                Are you sure you want to delete
                <strong>@Model.GradeName</strong> (Level: <span class="fw-semibold">@Model.GradeLevel</span>)?
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <!-- WARNING ALERT -->
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-exclamation-triangle-fill fs-2"></i>
            <div>
                <h5 class="alert-heading mb-2">Warning: This action cannot be undone!</h5>
                <p class="mb-1">
                    Deleting this grade will permanently remove it from the system.
                </p>
                <p class="mb-0">
                    <strong>Note:</strong> Students, courses, and other data associated with this grade may be affected.
                </p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <!-- GRADE DETAILS CARD -->
    <div class="card border-danger mb-3">
        <div class="card-header bg-danger bg-opacity-10 border-danger">
            <h5 class="mb-0 text-danger">
                <i class="bi bi-info-circle"></i> Grade Information
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <!-- LEFT: LEVEL BADGE & BASIC INFO -->
                <div class="col-md-5">
                    <div class="text-center mb-4">
                        <div class="level-badge-delete mb-3">
                            @Model.GradeLevel
                        </div>
                        <h4 class="mb-2">@Model.GradeName</h4>
                        <div class="text-muted small">
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-x-circle"></i> Inactive
                                </span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="mt-3">
                            <div class="text-muted small mb-2 fw-semibold">Description:</div>
                            <div class="description-preview">
                                @Model.Description
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted fst-italic">
                            No description available
                        </div>
                    }
                </div>

                <!-- RIGHT: DETAILED INFO -->
                <div class="col-md-7">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Grade Name</dt>
                        <dd class="col-sm-7">@TextOrDash(Model.GradeName)</dd>

                        <dt class="col-sm-5">Grade Level</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-primary">Level @Model.GradeLevel</span>
                        </dd>

                        <dt class="col-sm-5">Description</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                if (Model.Description.Length > 100)
                                {
                                    @(Model.Description.Substring(0, 100) + "...")
                                }
                                else
                                {
                                    @Model.Description
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7">
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary">
                                    Inactive
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-5">Created At</dt>
                        <dd class="col-sm-7">@DateTimeOrDash(Model.CreatedAt)</dd>

                        <dt class="col-sm-5">Updated At</dt>
                        <dd class="col-sm-7">@DateTimeOrDash(Model.UpdatedAt)</dd>

                        <dt class="col-sm-5">Grade ID</dt>
                        <dd class="col-sm-7">
                            <code class="text-muted">@Model.GradeId</code>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- IMPACT WARNING -->
    <div class="card border-warning mb-3">
        <div class="card-header bg-warning bg-opacity-10 border-warning">
            <h5 class="mb-0 text-warning">
                <i class="bi bi-exclamation-diamond"></i> Potential Impact
            </h5>
        </div>
        <div class="card-body">
            <p class="mb-2">Deleting this grade may affect the following:</p>
            <ul class="mb-0">
                <li>Students currently enrolled in this grade level</li>
                <li>Courses associated with this grade</li>
                <li>Academic records and transcripts</li>
                <li>Historical data and reports</li>
            </ul>
        </div>
    </div>

    <!-- CONFIRMATION CARD -->
    <div class="card border-danger">
        <div class="card-header bg-danger bg-opacity-10 border-danger">
            <h5 class="mb-0 text-danger">
                <i class="bi bi-shield-exclamation"></i> Confirmation Required
            </h5>
        </div>
        <div class="card-body">
            <p class="mb-3">
                Please confirm that you understand the consequences of this action:
            </p>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="confirmUnderstand">
                <label class="form-check-label" for="confirmUnderstand">
                    I understand this action is permanent and cannot be undone
                </label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="confirmAware">
                <label class="form-check-label" for="confirmAware">
                    I am aware that students and courses may be affected
                </label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="confirmBackup">
                <label class="form-check-label" for="confirmBackup">
                    I have backed up or exported any necessary data
                </label>
            </div>

            <form asp-action="Delete" id="deleteForm">
                <input type="hidden" asp-for="GradeId" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger btn-lg" id="deleteButton" disabled>
                        <i class="bi bi-trash"></i> Delete Grade
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ALTERNATIVE ACTION -->
    <div class="alert alert-info mt-3">
        <i class="bi bi-lightbulb"></i>
        <strong>Alternative:</strong> Consider setting this grade to "Inactive" status instead of deleting it.
        This preserves historical data while preventing new enrollments.
        <a asp-action="Edit" asp-route-id="@Model.GradeId" class="alert-link">Edit Grade →</a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Enable delete button only when all checkboxes are checked
            $('#confirmUnderstand, #confirmAware, #confirmBackup').on('change', function() {
                const allChecked = $('#confirmUnderstand').is(':checked') &&
                                  $('#confirmAware').is(':checked') &&
                                  $('#confirmBackup').is(':checked');
                $('#deleteButton').prop('disabled', !allChecked);
            });

            // Double confirmation before submit
            $('#deleteForm').on('submit', function(e) {
                const gradeName = '@Model.GradeName';
                const gradeLevel = '@Model.GradeLevel';

                const confirmText = `Are you absolutely sure you want to delete "${gradeName}" (Level ${gradeLevel})?\n\nThis action CANNOT be undone and may affect students and courses!`;

                if (!confirm(confirmText)) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}

<style>
    .level-badge-delete {
        width: 100px;
        height: 100px;
        border-radius: 16px;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 3rem;
        box-shadow: 0 8px 20px rgba(245, 87, 108, 0.4);
        position: relative;
    }

        .level-badge-delete::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 16px;
            border: 3px solid #dc2626;
            opacity: 0.5;
        }

    .description-preview {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 0.75rem;
        font-size: 0.9rem;
        line-height: 1.5;
        max-height: 150px;
        overflow-y: auto;
    }

    .card {
        border-radius: 10px;
    }

    .alert {
        border-radius: 10px;
    }

    dt {
        font-weight: 600;
        color: #6b7280;
    }

    dd {
        color: #1f2937;
    }

    .form-check-label {
        font-weight: 500;
    }

    .btn-danger:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .card-body ul {
        padding-left: 1.5rem;
    }

        .card-body ul li {
            margin-bottom: 0.5rem;
            color: #6b7280;
        }

    code {
        font-size: 0.875rem;
    }

    (max-width: 768px) {
        .level-badge-delete

    {
        width: 80px;
        height: 80px;
        font-size: 2.5rem;
    }

    }
</style>