@model DoAnChuyenNganh.Models.Grade

@{
    ViewData["Title"] = "Edit Grade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <!-- HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-pencil-square"></i> Edit Grade
            </h2>
            <p class="text-muted mb-0">Update grade information</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-gradient text-white">
                    <h5 class="mb-0">Grade Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="GradeId" />

                        <!-- BASIC INFO -->
                        <h5 class="section-header">
                            <i class="bi bi-info-circle"></i> Basic Information
                        </h5>
                        <div class="section-divider"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label asp-for="GradeName" class="form-label fw-semibold">
                                    Grade Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="GradeName" class="form-control form-control-lg"
                                       placeholder="Enter grade name" />
                                <span asp-validation-for="GradeName" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="GradeLevel" class="form-label fw-semibold">
                                    Grade Level <span class="text-danger">*</span>
                                </label>
                                <input asp-for="GradeLevel" class="form-control form-control-lg"
                                       type="number" min="1" max="20" id="gradeLevelInput" />
                                <span asp-validation-for="GradeLevel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Enter description for this grade level"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- LEVEL PREVIEW -->
                        <div class="alert alert-light border mb-4">
                            <div class="d-flex align-items-center">
                                <div class="level-badge-preview me-3" id="levelPreview">
                                    @Model.GradeLevel
                                </div>
                                <div>
                                    <strong>Level Preview</strong>
                                    <div class="text-muted small">This is how the level will appear</div>
                                </div>
                            </div>
                        </div>

                        <!-- STATUS - ĐÃ SỬA: Đảo thứ tự input -->
                        <h5 class="section-header">
                            <i class="bi bi-toggle-on"></i> Status
                        </h5>
                        <div class="section-divider"></div>

                        <div class="mb-4">
                            <div class="form-check form-switch form-switch-lg">
                                <!-- ✅ ĐẶT HIDDEN INPUT TRƯỚC CHECKBOX -->
                                <input type="hidden" name="IsActive" value="false" />
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       name="IsActive"
                                       value="true"
                                @(Model?.IsActive == true ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="IsActive">
                                    Active Grade
                                    <small class="d-block text-muted fw-normal">
                                        @if (Model?.IsActive == true)
                                        {
                                            <span class="text-success">✓ This grade is currently active</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning">⚠ This grade is currently inactive</span>
                                        }
                                    </small>
                                </label>
                            </div>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>

                        <!-- AUDIT INFO -->
                        <h5 class="section-header">
                            <i class="bi bi-clock-history"></i> Audit Information
                        </h5>
                        <div class="section-divider"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Created At</label>
                                <input type="text" class="form-control-plaintext"
                                       value="@(Model?.CreatedAt?.ToString("MMMM dd, yyyy 'at' HH:mm") ?? "N/A")" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Last Updated</label>
                                <input type="text" class="form-control-plaintext"
                                       value="@(Model?.UpdatedAt?.ToString("MMMM dd, yyyy 'at' HH:mm") ?? "Never")" readonly />
                            </div>
                        </div>

                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="UpdatedAt" value="@DateTime.Now" />

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Note:</strong> Update timestamp will be automatically recorded when you save changes.
                        </div>

                        <!-- ACTIONS -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ADDITIONAL INFO CARD -->
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-body">
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-lightbulb"></i> Quick Tips
                    </h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check2 text-success"></i>
                            Changes are saved immediately after clicking "Save Changes"
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check2 text-success"></i>
                            Inactive grades won't appear in active course lists
                        </li>
                        <li>
                            <i class="bi bi-check2 text-success"></i>
                            Grade level should remain consistent with other grades in the system
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Update level preview when level changes
            $('#gradeLevelInput').on('input', function() {
                const level = $(this).val();
                $('#levelPreview').text(level || '1');
            });

            // Status switch feedback
            $('#IsActive').on('change', function() {
                const isActive = $(this).is(':checked');
                const label = $(this).next('label').find('small');

                if (isActive) {
                    label.html('<span class="text-success">✓ This grade is currently active</span>');
                } else {
                    label.html('<span class="text-warning">⚠ This grade is currently inactive</span>');
                }
            });
        });
    </script>
}

<style>
    .bg-gradient {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .section-header {
        color: #374151;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .section-divider {
        height: 2px;
        background: linear-gradient(to right, #f093fb, #f5576c, transparent);
        margin-bottom: 1rem;
    }

    .form-label {
        color: #374151;
    }

    .fw-semibold {
        font-weight: 600;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
        border: 1px solid #d1d5db;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.2rem rgba(245, 87, 108, 0.25);
            border-color: #f5576c;
        }

    .form-switch-lg .form-check-input {
        width: 3rem;
        height: 1.5rem;
    }

    .level-badge-preview {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.8rem;
        box-shadow: 0 4px 12px rgba(245, 87, 108, 0.3);
        transition: transform 0.2s ease;
    }

        .level-badge-preview:hover {
            transform: scale(1.05);
        }

    .card {
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .shadow-sm {
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08) !important;
    }

    .alert {
        border-radius: 10px;
    }

     (max-width: 768px) {
        .btn-lg

    {
        width: 100%;
        margin-bottom: 10px;
    }

    .d-flex.gap-2 {
        flex-direction: column;
    }

    }
</style>