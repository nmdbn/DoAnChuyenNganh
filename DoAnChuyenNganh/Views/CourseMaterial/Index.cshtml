@model IEnumerable<DoAnChuyenNganh.Models.CourseMaterial>
@using System.Linq

@{
    ViewData["Title"] = "Course Materials";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="material-management-container">
    <!-- Header -->
    <div class="material-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h1><i class="bi bi-folder2-open"></i> Course Materials</h1>
                <p class="text-light-50 mb-0">
                    Manage course materials, lectures, slides, and attachments.
                </p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-light btn-lg shadow-sm">
                    <i class="bi bi-upload"></i> Upload New Material
                </a>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="material-stats">
        <div class="row g-3">
            <div class="col-md-4 col-12">
                <div class="stat-card">
                    <i class="bi bi-folder"></i>
                    <div class="stat-info">
                        <h3>@Model.Count()</h3>
                        <p>Total Materials</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-12">
                <div class="stat-card stat-success">
                    <i class="bi bi-unlock"></i>
                    <div class="stat-info">
                        <h3>@Model.Count(m => m.IsPublic == true)</h3>
                        <p>Public Materials</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-12">
                <div class="stat-card stat-warning">
                    <i class="bi bi-cloud-download"></i>
                    <div class="stat-info">
                        <h3>@Model.Sum(m => m.DownloadCount)</h3>
                        <p>Total Downloads</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Materials table -->
    <div class="materials-section">
        <div class="section-header d-flex justify-content-between align-items-center flex-wrap">
            <h2 class="mb-2 mb-md-0">
                <i class="bi bi-list-ul"></i> Material List
            </h2>
            <div class="search-filter">
                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search by material name, course, lesson...">
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table material-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>
                                <i class="bi bi-file-earmark-text"></i>
                                @Html.DisplayNameFor(model => model.MaterialName)
                            </th>
                            <th>
                                <i class="bi bi-tag"></i>
                                @Html.DisplayNameFor(model => model.MaterialType)
                            </th>
                            <th>
                                <i class="bi bi-folder"></i>
                                Course
                            </th>
                            <th>
                                <i class="bi bi-journal-text"></i>
                                Lesson
                            </th>
                            <th>
                                <i class="bi bi-hdd"></i>
                                @Html.DisplayNameFor(model => model.FileSize)
                            </th>
                            <th>
                                <i class="bi bi-download"></i>
                                @Html.DisplayNameFor(model => model.DownloadCount)
                            </th>
                            <th>
                                <i class="bi bi-eye"></i>
                                Visibility
                            </th>
                            <th>
                                <i class="bi bi-clock"></i>
                                @Html.DisplayNameFor(model => model.CreatedAt)
                            </th>
                            <th>
                                <i class="bi bi-person-circle"></i>
                                Uploader
                            </th>
                            <th class="text-center">
                                <i class="bi bi-gear"></i> Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="material-row">
                                <td>
                                    <div class="d-flex flex-column">
                                        <a href="@item.FileUrl"
                                           target="_blank"
                                           class="material-name-link">
                                            <i class="bi bi-file-earmark"></i> @item.MaterialName
                                        </a>
                                        <small class="text-muted d-none d-md-inline">
                                            @item.FileUrl
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-soft-primary text-primary">
                                        @item.MaterialType
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-soft-secondary">
                                        @Html.DisplayFor(modelItem => item.Course.CourseId)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-soft-secondary">
                                        @Html.DisplayFor(modelItem => item.Lesson.LessonId)
                                    </span>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.FileSize)</td>
                                <td>@Html.DisplayFor(modelItem => item.DownloadCount)</td>
                                <td class="status-cell">
                                    @if (item.IsPublic == true)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-unlock"></i> Public
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-locked">
                                            <i class="bi bi-lock-fill"></i> Private
                                        </span>
                                    }
                                </td>
                                <td>
                                    @(item.CreatedAt.HasValue
                                        ? item.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        : "")
                                </td>
                                <td>
                                    <span class="badge bg-soft-dark">
                                        @Html.DisplayFor(modelItem => item.CreatedByNavigation.UserId)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.MaterialId"
                                           class="btn btn-sm btn-outline-info"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.MaterialId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.MaterialId"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info d-flex align-items-center mt-3">
                <i class="bi bi-info-circle-fill me-2"></i>
                <div>
                    There are no materials yet. Click
                    <strong>"Upload New Material"</strong> to add the first one.
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // realtime search
            $('#searchInput').on('keyup', function () {
                const value = $(this).val().toLowerCase();
                $('.material-row').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}

<style>
    .material-management-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .material-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 28px 30px;
        border-radius: 16px;
        box-shadow: 0 15px 30px rgba(15, 23, 42, 0.35);
        margin-bottom: 24px;
    }

        .material-header h1 {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .material-header p {
            margin: 0;
            opacity: 0.9;
        }

        .material-header .btn {
            border-radius: 999px;
            font-weight: 500;
        }

    .text-light-50 {
        color: rgba(255, 255, 255, 0.75);
    }

    .material-stats {
        margin-bottom: 24px;
    }

    .stat-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.1);
        border: 1px solid #e5e7eb;
    }

        .stat-card i {
            font-size: 2rem;
            color: #6366f1;
        }

        .stat-card .stat-info h3 {
            margin: 0;
            font-size: 1.4rem;
            font-weight: 600;
            color: #111827;
        }

        .stat-card .stat-info p {
            margin: 0;
            color: #6b7280;
            font-size: 0.9rem;
        }

    .stat-success i {
        color: #16a34a;
    }

    .stat-warning i {
        color: #f59e0b;
    }

    .materials-section {
        background: #ffffff;
        border-radius: 14px;
        padding: 18px 20px 10px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        border: 1px solid #e5e7eb;
    }

    .section-header h2 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 600;
        color: #111827;
    }

    .search-filter {
        max-width: 320px;
        width: 100%;
    }

        .search-filter input {
            border-radius: 999px;
        }

    .table-responsive {
        border-radius: 12px;
        overflow: hidden;
        margin-top: 12px;
    }

    .material-table {
        margin-bottom: 0;
        font-size: 0.92rem;
    }

        .material-table thead {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: #fff;
        }

            .material-table thead th {
                font-weight: 500;
                border-bottom: none;
                padding-top: 10px;
                padding-bottom: 10px;
                white-space: nowrap;
            }

        .material-table tbody tr.material-row {
            transition: background-color 0.15s ease, transform 0.1s ease;
        }

            .material-table tbody tr.material-row:hover {
                background-color: #f9fafb;
                transform: translateY(-1px);
            }

        .material-table tbody td {
            vertical-align: middle;
        }

    .material-name-link {
        font-weight: 500;
        color: #111827;
        text-decoration: none;
    }

        .material-name-link:hover {
            color: #4f46e5;
            text-decoration: underline;
        }

    .badge.bg-soft-primary {
        background: #eef2ff;
        color: #4f46e5;
    }

    .badge.bg-soft-secondary {
        background: #f3f4f6;
        color: #4b5563;
    }

    .badge.bg-soft-dark {
        background: #111827;
        color: #f9fafb;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .status-active {
        background: #dcfce7;
        color: #166534;
    }

    .status-locked {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-badge i {
        font-size: 0.85rem;
    }

    .btn-group .btn {
        border-radius: 999px !important;
    }

    .alert-info {
        background: #dbeafe;
        border: 1px solid #93c5fd;
        color: #1e40af;
        border-radius: 10px;
        padding: 16px;
    }

    (max-width: 768px) {
        .material-header

    {
        padding: 22px 18px;
    }

    .stat-card {
        padding: 14px 14px;
    }

    .materials-section {
        padding: 14px 14px 8px;
    }

    .section-header {
        gap: 10px;
    }

    }
</style>
