<div class="learning-container">
    @if (Model.CanRate)
    {
        <div class="rating-card" id="ratingCard">
            <button type="button" class="rating-toggle-btn" id="ratingToggle" aria-label="Toggle rating card">
                <i class="bi bi-chevron-right"></i>
            </button>
            <div class="rating-header">
                <h5>
                    <i class="bi bi-star-fill me-2"></i>
                    Rate This Course
                </h5>
                @* <div class="rating-title-collapsed"> *@
                @*     <i class="bi bi-star-fill me-2"></i> *@
                @*     Rate This Course *@
                @* </div> *@
                <div class="course-rating-stats">
                    <span class="rating-number">@Model.Course.AverageRating?.ToString("F1")</span>
                    <div class="stars-display">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var fullStars = Math.Floor(Model.Course.AverageRating ?? 0);
                            if (i <= fullStars)
                            {
                                <i class="bi bi-star-fill text-warning"></i>
                            }
                            else if (i == fullStars + 1 && (Model.Course.AverageRating ?? 0m) % 1m >= 0.5m)
                            {
                                <i class="bi bi-star-half text-warning"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-warning"></i>
                            }
                        }
                    </div>
                    <span class="rating-count">(@(Model.Course.RatingCount ?? 0) ratings)</span>
                </div>
            </div>

            <div class="rating-body">
                @if (Model.UserRating != null)
                {
                    <div class="alert alert-success mb-3">
                        <i class="bi bi-check-circle me-2"></i>
                        You rated <strong>@Model.UserRating.Rating ⭐</strong>
                        @if (Model.UserRating.CreatedAt.HasValue)
                        {
                            <span class="text-muted d-block mt-1" style="font-size: 0.85rem;">
                                @Model.UserRating.CreatedAt.Value.ToString("MMM dd, yyyy")
                            </span>
                        }
                    </div>
                }

                <form id="ratingForm" class="rating-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="courseId" value="@Model.Course.CourseId" />

                    <div class="star-rating-input">
                        <label class="form-label fw-semibold">Your Rating:</label>
                        <div class="stars-input">
                            @for (int i = 5; i >= 1; i--)
                            {
                                var isChecked = Model.UserRating?.Rating == i ? "checked" : "";
                                <input type="radio" name="rating" id="star@(i)" value="@i" @isChecked />
                                <label for="star@(i)" class="star-label">
                                    <i class="bi bi-star-fill"></i>
                                </label>
                            }
                        </div>
                        <span id="ratingError" class="text-danger small d-none">Please select a rating</span>
                    </div>

                    <div class="mb-3">
                        <label for="review" class="form-label fw-semibold">Review (Optional):</label>
                        <textarea id="review" name="review" class="form-control" rows="3" maxlength="1000" placeholder="Share your thoughts...">@(Model.UserRating?.Review ?? "")</textarea>
                        <small class="text-muted">Max 1000 characters</small>
                    </div>

                    <button type="submit" class="btn-submit-rating">
                        <i class="bi bi-send-fill"></i>
                        @(Model.UserRating != null ? "Update Rating" : "Submit Rating")
                    </button>
                </form>
            </div>
        </div>
    }
    <div class="container-fluid">
        <div class="row g-4">
            <!-- SIDEBAR: Lesson list -->
            <div class="col-lg-3">
                <div class="sidebar-card">
                    <div class="sidebar-header">
                        <i class="bi bi-list-ul"></i>
                        <span>Course Outline</span>
                    </div>
                    <div class="lesson-list">
                        @if (Model.Lessons != null && Model.Lessons.Any())
                        {
                            foreach (var lesson in Model.Lessons)
                            {
                                var isActive = Model.CurrentLessonId == lesson.LessonId;
                                var hasProgress = Model.HasProgressForLesson != null &&
                                Model.HasProgressForLesson.ContainsKey(lesson.LessonId) &&
                                Model.HasProgressForLesson[lesson.LessonId];
                                var activeClass = isActive ? "active" : "";
                                var completedClass = hasProgress ? "completed" : "";

                                <a asp-action="Learning"
                                   asp-route-id="@Model.Course.CourseId"
                                   asp-route-lessonId="@lesson.LessonId"
                                   class="lesson-item @activeClass @completedClass">
                                    <div class="lesson-icon">
                                        @if (lesson.LessonType == "video")
                                        {
                                            <i class="bi bi-play-circle-fill"></i>
                                        }
                                        else if (lesson.LessonType == "quiz")
                                        {
                                            <i class="bi bi-ui-checks-grid"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-text"></i>
                                        }
                                    </div>
                                    <div class="lesson-content">
                                        <div class="lesson-title">Lesson @lesson.LessonOrder</div>
                                        <div class="lesson-meta">@lesson.Title</div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-inbox" style="font-size: 2rem; display: block; margin-bottom: 1rem;"></i>
                                No lessons available
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- MAIN CONTENT -->
            <div class="col-lg-9">
                
                @if (currentLesson == null)
                {
                    <div class="main-content-card">
                        <div class="content-section text-center py-5">
                            <i class="bi bi-info-circle" style="font-size: 3rem; color: #667eea; display: block; margin-bottom: 1rem;"></i>
                            <h4>No lessons published yet</h4>
                            <p class="text-muted">This course doesn't have any published lessons at the moment.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="main-content-card">
                        <!-- LESSON HEADER -->
                        <div class="lesson-header">
                            <h3>@currentLesson.Title</h3>
                            <div class="lesson-header-meta">
                                <span><i class="bi bi-book-half me-2"></i>Lesson @currentLesson.LessonOrder</span>
                                @if (isVideoLesson)
                                {
                                    <span><i class="bi bi-camera-video me-2"></i>Video Lesson</span>
                                }
                                else if (isQuizLesson)
                                {
                                    <span><i class="bi bi-patch-question me-2"></i>Quiz Lesson</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-file-text me-2"></i>Text Lesson</span>
                                }
                            </div>
                        </div>

                        <!-- LESSON TEXT CONTENT -->
                        @if (!string.IsNullOrWhiteSpace(currentLesson.Content))
                        {
                            <div class="content-section">
                                <h5 class="section-title">
                                    <i class="bi bi-file-richtext"></i>
                                    Lesson Content
                                </h5>
                                <div class="text-body">
                                    @Html.Raw(currentLesson.Content)
                                </div>
                            </div>
                        }

                        <!-- VIDEO SECTION -->
                        @if (isVideoLesson && !string.IsNullOrEmpty(currentLesson.VideoUrl))
                        {
                            <div class="content-section">
                                <h5 class="section-title">
                                    <i class="bi bi-play-btn"></i>
                                    Video Content
                                </h5>
                                <div class="video-container">
                                    <video src="@currentLesson.VideoUrl"
                                           controls
                                           preload="metadata"
                                           style="width:100%; height:auto; display:block;">
                                        Your browser does not support the video tag.
                                    </video>
                                </div>
                            </div>
                        }

                        <!-- MATERIALS -->
                        @if (Model.CurrentMaterials != null && Model.CurrentMaterials.Any())
                        {
                            <div class="content-section">
                                <h5 class="section-title">
                                    <i class="bi bi-paperclip"></i>
                                    Attachments
                                </h5>
                                @foreach (var m in Model.CurrentMaterials)
                                {
                                    <div class="attachment-item">
                                        <a href="@m.FileUrl" target="_blank" class="attachment-link">
                                            <div class="attachment-icon">
                                                <i class="bi bi-file-earmark"></i>
                                            </div>
                                            <span>@m.MaterialName</span>
                                        </a>
                                        <span class="badge bg-secondary text-uppercase">@m.MaterialType</span>
                                    </div>
                                }
                            </div>
                        }

                        <!-- QUIZ SECTION -->
                            @* ✅ THAY THẾ PHẦN HIỂN THỊ KẾT QUẢ QUIZ TRONG Learning.cshtml *@
                            @* Tìm phần "@if (isQuizLesson)" và thay thế phần hiển thị kết quả *@

                            @if (isQuizLesson)
                            {
                            <div class="quiz-container">
                                    @if (Model.QuizResult != null)
                                    {
                                        var r = Model.QuizResult;
                                        var isPass = r.PercentageScore >= 60;

                                    <div class="quiz-result-header @(isPass ? "pass" : "fail")">
                                        <h3>@(isPass ? "Congratulations! 🎉" : "Keep Trying! 💪")</h3>
                                        <div class="score-display">
                                                @r.TotalScore / @r.MaxScore
                                        </div>
                                        <h4>@r.PercentageScore.ToString("F1")%</h4>
                                        <p class="lead mb-0">
                                                @if (isPass)
                                                {
                                                <span>You've passed this quiz!</span>
                                                }
                                                else
                                                {
                                                <span>Don't give up, try again!</span>
                                                }
                                        </p>
                                    </div>

                                        @* ✅ LEGEND: Giải thích màu sắc *@
                                    <div class="alert alert-info mb-4" style="border-radius: 12px;">
                                        <div class="d-flex align-items-center gap-3 flex-wrap">
                                            <strong><i class="bi bi-info-circle me-2"></i>Legend:</strong>
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Correct Answer</span>
                                            <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Your Wrong Answer</span>
                                            <span class="badge bg-secondary"><i class="bi bi-circle me-1"></i>Not Selected</span>
                                        </div>
                                    </div>

                                        @foreach (var q in r.Questions)
                                        {
                                            var questionIndex = r.Questions.IndexOf(q) + 1;

                                        <div class="question-card">
                                            <div class="question-header">
                                                <span class="question-number">Question @(questionIndex)</span>
                                                <div>
                                                    <div>@q.QuestionText</div>
                                                    <small class="text-muted">(@q.Points points)</small>
                                                </div>
                                            </div>

                                                @if (q.QuestionType == "multiple_choice")
                                                {
                                                    var correctIds = q.CorrectAnswerIds ?? new List<int>();
                                                    var selectedIds = q.SelectedAnswerIds ?? new List<int>();

                                                    @foreach (var a in q.Answers)
                                                    {
                                                        bool isCorrect = correctIds.Contains(a.AnswerId);
                                                        bool isSelected = selectedIds.Contains(a.AnswerId);

                                                        string cssClass = "neutral";
                                                        string icon = "bi-circle";
                                                        string badge = "";

                                                        if (isCorrect)
                                                        {
                                                            // ✅ Đáp án đúng luôn màu xanh
                                                            cssClass = "correct";
                                                            icon = "bi-check-circle-fill";
                                                            badge = isSelected
                                                            ? "<span class='badge bg-success ms-2'>✓ Your Answer (Correct)</span>"
                                                            : "<span class='badge bg-success ms-2'>✓ Correct Answer</span>";
                                                        }
                                                        else if (isSelected)
                                                        {
                                                            // ❌ User chọn sai → màu đỏ
                                                            cssClass = "incorrect";
                                                            icon = "bi-x-circle-fill";
                                                            badge = "<span class='badge bg-danger ms-2'>✗ Your Answer (Wrong)</span>";
                                                        }

                                                    <div class="answer-option @cssClass">
                                                        <div class="answer-icon">
                                                            <i class="bi @icon"></i>
                                                        </div>
                                                        <span>@a.AnswerText @Html.Raw(badge)</span>
                                                    </div>
                                                    }

                                                <div class="mt-3 pt-3 border-top">
                                                    <strong>Your Score:</strong>
                                                    <span class="badge @(q.EarnedPoints == q.Points ? "bg-success" : "bg-danger") ms-2" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                                            @q.EarnedPoints / @q.Points
                                                    </span>

                                                        @if (correctIds.Count > 1)
                                                        {
                                                        <div class="alert alert-warning mt-3 mb-0" style="border-radius: 10px;">
                                                            <i class="bi bi-info-circle me-1"></i>
                                                            <strong>Note:</strong> This question has multiple correct answers.
                                                            You must select <strong>all correct answers</strong> to earn points.
                                                                @if (selectedIds.Count != correctIds.Count || selectedIds.Except(correctIds).Any())
                                                                {
                                                                <br />
                                                                <small class="text-muted">
                                                                    You selected @selectedIds.Count answer(s), but @correctIds.Count answer(s) are correct.
                                                                </small>
                                                                }
                                                        </div>
                                                        }
                                                </div>

                                                    @if (!string.IsNullOrWhiteSpace(q.Explanation))
                                                    {
                                                    <div class="explanation-box">
                                                        <i class="bi bi-lightbulb-fill"></i>
                                                        <strong>Explanation:</strong>
                                                        <div class="mt-2">@q.Explanation</div>
                                                    </div>
                                                    }
                                                }
                                                else
                                                {
                                                    @* Essay Question Display *@
                                                <div class="alert alert-secondary">
                                                    <strong>Essay Question</strong>
                                                    <div class="mt-2 text-muted">
                                                        Essay questions require manual grading by the instructor.
                                                    </div>

                                                    <hr />

                                                    <strong>Score:</strong>
                                                    <span class="badge @(q.EarnedPoints > 0 ? "bg-success" : "bg-secondary") ms-2">
                                                            @q.EarnedPoints / @q.Points
                                                    </span>

                                                        @if (!string.IsNullOrWhiteSpace(q.Explanation))
                                                        {
                                                        <div class="explanation-box mt-3">
                                                            <i class="bi bi-lightbulb-fill"></i>
                                                            <strong>Explanation:</strong>
                                                            <div class="mt-2">@q.Explanation</div>
                                                        </div>
                                                        }
                                                </div>
                                                }
                                        </div>
                                        }
                                    }
                                    else if (Model.QuizToTake != null)
                                    {
                                    <div class="alert alert-info mb-4">
                                        <i class="bi bi-info-circle me-2"></i>
                                        This quiz has <strong>@Model.QuizToTake.Questions.Count questions</strong>. Good luck!
                                    </div>

                                    <form asp-action="SubmitQuizFromLearning" method="post" class="quiz-form">
                                            @Html.AntiForgeryToken()

                                        <input type="hidden" name="courseId" value="@Model.Course.CourseId" />
                                        <input type="hidden" name="lessonId" value="@currentLesson.LessonId" />
                                        <input type="hidden" name="model.AttemptId" value="@Model.QuizToTake.AttemptId" />

                                            @for (var i = 0; i < Model.QuizToTake.Questions.Count; i++)
                                            {
                                                var q = Model.QuizToTake.Questions[i];

                                            <div class="question-card">
                                                <div class="question-header">
                                                    <span class="question-number">Q@(i + 1)</span>
                                                    <div>
                                                        <div>@q.QuestionText</div>
                                                        <small class="text-muted">(@q.Points points)</small>
                                                    </div>
                                                </div>

                                                <input type="hidden" name="model.Answers[@i].QuestionId" value="@q.QuestionId" />

                                                    @if (q.QuestionType == "multiple_choice")
                                                    {
                                                        @if (q.AllowMultipleCorrect)
                                                        {
                                                            @for (var j = 0; j < q.Answers.Count; j++)
                                                            {
                                                                var a = q.Answers[j];
                                                            <div class="form-check">
                                                                <input class="form-check-input"
                                                                       type="checkbox"
                                                                       name="model.Answers[@i].SelectedAnswerIds"
                                                                       id="answer_@(i)_@(j)"
                                                                       value="@a.AnswerId" />
                                                                <label class="form-check-label" for="answer_@(i)_@(j)">
                                                                        @a.AnswerText
                                                                </label>
                                                            </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @for (var j = 0; j < q.Answers.Count; j++)
                                                            {
                                                                var a = q.Answers[j];
                                                            <div class="form-check">
                                                                <input class="form-check-input"
                                                                       type="radio"
                                                                       name="model.Answers[@i].SelectedAnswerIds"
                                                                       id="answer_@(i)_@(j)"
                                                                       value="@a.AnswerId" />
                                                                <label class="form-check-label" for="answer_@(i)_@(j)">
                                                                        @a.AnswerText
                                                                </label>
                                                            </div>
                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                    <textarea name="model.Answers[@i].EssayAnswer"
                                                              class="form-control"
                                                              rows="5"
                                                              placeholder="Enter your answer here..."
                                                              style="border-radius: 10px;"></textarea>
                                                    }
                                            </div>
                                            }

                                        <div class="text-center mt-4">
                                            <button type="submit" class="submit-btn">
                                                <i class="bi bi-send-fill me-2"></i>Submit Quiz
                                            </button>
                                        </div>
                                    </form>
                                    }
                                    else
                                    {
                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                        Quiz is not configured or loading...
                                    </div>
                                    }
                            </div>
                            }

                        <!-- NAVIGATION BUTTONS -->
                        <div class="navigation-buttons">
                            <div>
                                @if (previousLesson != null)
                                {
                                    <a asp-action="Learning"
                                       asp-route-id="@Model.Course.CourseId"
                                       asp-route-lessonId="@previousLesson.LessonId"
                                       class="nav-btn nav-btn-prev">
                                        <i class="bi bi-chevron-left"></i>
                                        Previous
                                    </a>
                                }
                            </div>
                            <div>
                                @if (nextLesson != null)
                                {
                                    <a asp-action="Learning"
                                       asp-route-id="@Model.Course.CourseId"
                                       asp-route-lessonId="@nextLesson.LessonId"
                                       class="nav-btn nav-btn-next">
                                        Next
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
<script>
        document.getElementById('ratingToggle')?.addEventListener('click', function() {
        const card = document.querySelector('.rating-card'); // tìm theo class
        if (card) {
            card.classList.toggle('collapsed');
            const isCollapsed = card.classList.contains('collapsed');
            localStorage.setItem('ratingCardCollapsed', isCollapsed);

            // Bonus: đổi icon mũi tên khi thu gọn/mở
            const icon = this.querySelector('i');
            if (isCollapsed) {
                // Thu gọn → hiển thị mũi tên TRÁI (mời mở ra)
                icon.classList.replace('bi-chevron-right', 'bi-chevron-left');
            } else {
                icon.classList.replace('bi-chevron-left', 'bi-chevron-right');
            }
        }
    });

    // ✅ Restore: Khôi phục icon khi load trang
    document.addEventListener('DOMContentLoaded', function() {
        const card = document.getElementById('ratingCard');
        const toggleBtn = document.getElementById('ratingToggle');
        const isCollapsed = localStorage.getItem('ratingCardCollapsed') === 'true';

        if (isCollapsed && card && toggleBtn) {
            card.classList.add('collapsed');
            // Khi đã collapsed → icon phải là chevron-left
            const icon = toggleBtn.querySelector('i');
            icon.classList.replace('bi-chevron-right', 'bi-chevron-left');
        }
    });

    // Existing rating form submission code...
    document.getElementById('ratingForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();

        const courseId = document.getElementById('courseId').value;
        const ratingInput = document.querySelector('input[name="rating"]:checked');
        const review = document.getElementById('review').value;
        const errorSpan = document.getElementById('ratingError');
        const submitBtn = e.target.querySelector('.btn-submit-rating');

        if (!ratingInput) {
            errorSpan.classList.remove('d-none');
            return;
        }
        errorSpan.classList.add('d-none');

        const rating = parseInt(ratingInput.value);
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Submitting...';

        try {
            const formData = new FormData();
            formData.append('courseId', courseId);
            formData.append('rating', rating);
            formData.append('review', review);

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/Course/SubmitRatingInline', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show';
                alertDiv.innerHTML = `
                    <i class="bi bi-check-circle me-2"></i>
                    ${result.message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.querySelector('.rating-body').insertBefore(alertDiv, document.querySelector('.rating-form'));

                document.querySelector('.rating-number').textContent = result.averageRating.toFixed(1);
                document.querySelector('.rating-count').textContent = `(${result.ratingCount} ratings)`;

                setTimeout(() => {
                    alertDiv.remove();
                }, 5000);
            } else {
                alert(result.message || 'An error occurred');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An error occurred while submitting your rating');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Submit Rating';
        }
    });
</script>