@model DoAnChuyenNganh.Models.Course

@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Safe date formatter for ANY type
    string SafeDate(object? dateValue)
    {
        if (dateValue is DateTime dt)
            return $"{dt:dd/MM/yyyy HH:mm}";
        if (dateValue != null)
            return dateValue.ToString()!;
        return "-";
    }

    string SubjectDisplay() => Model.Subject?.SubjectName ?? "-";
    string GradeDisplay() => Model.Grade?.GradeName ?? "-";

    string InstructorDisplay()
    {
        if (Model.Instructor == null) return "-";
        var fullName = $"{Model.Instructor.FirstName} {Model.Instructor.LastName}".Trim();
        return !string.IsNullOrWhiteSpace(fullName) ? fullName : $"UserID: {Model.Instructor.UserId}";
    }

    string PriceDisplay(decimal? price) =>
        price.HasValue && price.Value > 0 ? $"{price.Value:N0} VND" : "Free";
}

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1 text-danger">
                <i class="bi bi-exclamation-triangle"></i> Delete Course
            </h2>
            <div class="text-muted">
                You are about to permanently delete:
                <span class="fw-semibold">@Model.Title</span>
                (ID: <span class="fw-semibold">@Model.CourseId</span>)
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="alert alert-warning d-flex align-items-center mb-3">
        <i class="bi bi-exclamation-circle me-2"></i>
        <div>This action <strong>cannot be undone</strong>.</div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card h-100 border-danger-subtle">
                <div class="card-body">
                    <div class="rounded overflow-hidden mb-3" style="width:100%;height:180px;background:#f3f4f6;">
                        @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
                        {
                            <img src="@Model.ThumbnailUrl" class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                <i class="bi bi-book fs-1"></i>
                            </div>
                        }
                    </div>

                    <h5 class="mb-1">@Model.Title</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                    {
                        <p class="text-muted small">@Model.ShortDescription</p>
                    }

                    <div class="small text-muted mt-3">Subject</div>
                    <div class="fw-semibold">@SubjectDisplay()</div>

                    <div class="small text-muted mt-3">Instructor</div>
                    <div class="fw-semibold">@InstructorDisplay()</div>

                    <div class="small text-muted mt-3">Price</div>
                    <div class="fw-semibold">@PriceDisplay(Model.Price)</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card border-danger">
                <div class="card-body">
                    <h5 class="text-danger mb-3">
                        <i class="bi bi-info-circle"></i> Course Information
                    </h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100 bg-light-subtle">
                                <div class="small text-muted mb-1">Difficulty</div>
                                @if (Model.DifficultyLevel > 0)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        Level @Model.DifficultyLevel
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }

                                <div class="small text-muted mt-3">Estimated Hours</div>
                                <div class="fw-semibold">
                                    @(Model.EstimatedHours > 0 ? $"{Model.EstimatedHours} hours" : "-")
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100 bg-light-subtle">
                                <div class="small text-muted">Created At</div>
                                <div class="fw-semibold">@SafeDate(Model.CreatedAt)</div>

                                <div class="small text-muted mt-3">Updated At</div>
                                <div class="fw-semibold">@SafeDate(Model.UpdatedAt)</div>

                                <div class="small text-muted mt-3">Published At</div>
                                <div class="fw-semibold">@SafeDate(Model.PublishedAt)</div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                        <div class="text-danger mb-2 mb-md-0">
                            Are you sure you want to delete this course?
                        </div>
                        <form asp-action="Delete" class="d-flex gap-2">
                            <input type="hidden" asp-for="CourseId" />
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Yes, delete it
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
    }

    .border-danger-subtle {
        border-color: #fecaca !important;
    }

    .object-fit-cover {
        object-fit: cover;
    }
</style>
