@model List<DoAnChuyenNganh.Models.Payment>

@{
    ViewData["Title"] = "Manage Payments";
    var isAdmin = (ViewBag.IsAdmin as bool?) ?? false;

    string status = ViewBag.Status ?? "";
    string method = ViewBag.Method ?? "";
    string q = ViewBag.Q ?? "";
    string from = ViewBag.From ?? "";
    string to = ViewBag.To ?? "";

    int totalCount = (ViewBag.TotalCount as int?) ?? Model.Count;
    decimal totalRevenueCompleted = (ViewBag.TotalRevenueCompleted as decimal?) ?? 0m;
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-1">
                <i class="bi bi-credit-card-2-front"></i> Manage Payments
            </h3>
            <div class="text-muted">
                @(isAdmin ? "Admin: xem tất cả thanh toán" : "Instructor: chỉ xem thanh toán của khóa học của bạn")
            </div>
        </div>
        <div class="text-end">
            <div><strong>Total:</strong> @totalCount payments</div>
            <div class="text-success"><strong>Revenue (Completed):</strong> @totalRevenueCompleted.ToString("N0") VND</div>
        </div>
    </div>

    <form method="get" class="card card-body mb-3 shadow-sm">
        <div class="row g-2">
            <div class="col-md-2">
                <label class="form-label fw-semibold">Status</label>
                <select class="form-select" name="status">
                    <option value="" selected="@(string.IsNullOrEmpty(status))">All</option>
                    <option value="Pending" selected="@(status=="Pending")">Pending</option>
                    <option value="Completed" selected="@(status=="Completed")">Completed</option>
                    <option value="Failed" selected="@(status=="Failed")">Failed</option>
                    <option value="Cancelled" selected="@(status=="Cancelled")">Cancelled</option>
                    <option value="CODPending" selected="@(status=="CODPending")">COD Pending</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Method</label>
                <select class="form-select" name="method">
                    <option value="" selected="@(string.IsNullOrEmpty(method))">All</option>
                    <option value="COD" selected="@(method=="COD")">COD</option>
                    <option value="MoMo" selected="@(method=="MoMo")">MoMo</option>
                    <option value="VNPay" selected="@(method=="VNPay")">VNPay</option>
                    <option value="PayPal" selected="@(method=="PayPal")">PayPal</option>
                    <option value="Free" selected="@(method=="Free")">Free</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Search</label>
                <input class="form-control" name="q" value="@q" placeholder="Course / user / txnId / orderId..." />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">From</label>
                <input class="form-control" type="date" name="from" value="@from" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">To</label>
                <input class="form-control" type="date" name="to" value="@to" />
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Course</th>
                        <th>Student</th>
                        <th class="text-end">Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Paid</th>
                        <th>Txn / Order</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3"></i>
                                <p class="mb-0 mt-2">No payments found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            var studentName = p.User != null
                            ? $"{p.User.FirstName} {p.User.LastName} (@{p.User.Username})".Trim()
                            : $"UserId: {p.UserId}";

                            var courseTitle = p.Course?.Title ?? $"CourseId: {p.CourseId}";
                            var txn = !string.IsNullOrEmpty(p.TransactionId) ? p.TransactionId
                            : !string.IsNullOrEmpty(p.MoMoOrderId) ? ("MoMo: " + p.MoMoOrderId)
                            : !string.IsNullOrEmpty(p.VnPayOrderId) ? ("VNPay: " + p.VnPayOrderId)
                            : "-";

                            <tr>
                                <td class="fw-semibold">@p.PaymentId</td>
                                <td>
                                    <div class="fw-semibold text-primary">@courseTitle</div>
                                    @if (p.Course?.Instructor != null)
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-person-badge"></i>
                                            @($"{p.Course.Instructor.FirstName} {p.Course.Instructor.LastName}")
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div>@studentName</div>
                                    @if (!string.IsNullOrEmpty(p.PhoneNumber))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-telephone"></i> @p.PhoneNumber
                                        </div>
                                    }
                                </td>
                                <td class="text-end fw-bold">@p.Amount.ToString("N0") VND</td>
                                <td>
                                    <span class="badge bg-info">@p.PaymentMethod</span>
                                </td>
                                <td>
                                    @{
                                        var badge = p.Status == "Completed" ? "bg-success"
                                        : p.Status == "CODPending" ? "bg-warning text-dark"
                                        : p.Status == "Pending" ? "bg-secondary"
                                        : p.Status == "Failed" ? "bg-danger"
                                        : p.Status == "Cancelled" ? "bg-dark"
                                        : "bg-info";
                                    }
                                    <span class="badge @badge">@p.Status</span>
                                </td>
                                <td>
                                    <small>@p.CreatedAt.ToString("dd/MM/yyyy")</small><br>
                                    <small class="text-muted">@p.CreatedAt.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    @if (p.PaidAt.HasValue)
                                    {
                                        <small>@p.PaidAt.Value.ToString("dd/MM/yyyy")</small>

                                        <br>
                                        <small class="text-muted">@p.PaidAt.Value.ToString("HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-muted small">@txn</td>
                                <td class="text-center">
                                    @if (p.Status == "CODPending")
                                    {
                                        <form asp-action="ApproveCODPayment"
                                              asp-route-paymentId="@p.PaymentId"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Are you sure you want to approve this COD payment? An email will be sent to the student.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    title="Approve COD Payment">
                                                <i class="bi bi-check-circle"></i> Approve
                                            </button>
                                        </form>
                                    }
                                    else if (p.Status == "Completed")
                                    {
                                        <span class="text-success small">
                                            <i class="bi bi-check-circle-fill"></i> Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .btn-sm {
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .form-select:focus,
    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
</style>