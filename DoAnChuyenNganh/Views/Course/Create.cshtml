@model DoAnChuyenNganh.Models.Lesson

@{
    ViewData["Title"] = "Create Lesson";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2><i class="bi bi-plus-circle"></i> Create New Lesson</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="lessonForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- BASIC INFO -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Lesson Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-7">
                        <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Enter lesson title" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="LessonOrder" class="form-label">Order <span class="text-danger">*</span></label>
                        <input asp-for="LessonOrder" class="form-control" type="number" min="1" />
                        <span asp-validation-for="LessonOrder" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-7">
                        <label asp-for="CourseId" class="form-label">Course <span class="text-danger">*</span></label>
                        <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId">
                            <option value="">-- Select Course --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="LessonType" class="form-label">Type</label>
                        <select asp-for="LessonType" class="form-select" id="lessonTypeSelect">
                            <option value="text">Text</option>
                            <option value="video">Video</option>
                            <option value="quiz">Quiz</option>
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <label asp-for="Content" class="form-label">Content</label>
                    <textarea asp-for="Content" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <!-- QUIZ EDITOR -->
        <div id="quizEditor" class="card border-warning mb-3" style="display:none;">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-question-circle"></i> Quiz Editor</strong>
                <button type="button" class="btn btn-sm btn-success" id="addQuestionBtn">
                    <i class="bi bi-plus-circle"></i> Add Question
                </button>
            </div>
            <div class="card-body">
                <input type="hidden" name="QuizData" id="quizDataInput" />

                <div id="questionsContainer">
                    <!-- Questions will be added here dynamically -->
                </div>

                <div id="emptyState" class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-2">No questions yet. Click "Add Question" to start.</p>
                </div>
            </div>
        </div>

        <!-- SUBMIT -->
        <div class="d-flex gap-2 mb-4">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-save"></i> Create Lesson
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>

<!-- QUESTION TEMPLATE -->
<template id="questionTemplate">
    <div class="question-item card mb-3" data-question-index="0">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong class="question-title">Question 1</strong>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-danger remove-question-btn">
                    <i class="bi bi-trash"></i> Remove
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Question Text <span class="text-danger">*</span></label>
                <textarea class="form-control question-text" rows="2" placeholder="Enter question text" required></textarea>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Type</label>
                    <select class="form-select question-type">
                        <option value="multiple_choice" selected>Multiple Choice</option>
                        <option value="essay">Essay</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Points</label>
                    <input type="number" class="form-control question-points" value="10" min="1" />
                </div>
            </div>

            <div class="answers-section">
                <label class="form-label">Answers (2-5 options, at least 1 correct)</label>
                <div class="answers-container"></div>
                <button type="button" class="btn btn-sm btn-outline-primary add-answer-btn mt-2">
                    <i class="bi bi-plus"></i> Add Answer
                </button>
            </div>

            <div class="mt-3">
                <label class="form-label">Explanation (optional)</label>
                <textarea class="form-control question-explanation" rows="2" placeholder="Explain the correct answer"></textarea>
            </div>
        </div>
    </div>
</template>

<!-- ANSWER TEMPLATE -->
<template id="answerTemplate">
    <div class="answer-item input-group mb-2" data-answer-index="0">
        <div class="input-group-text">
            <input type="checkbox" class="form-check-input answer-correct" title="Mark as correct">
        </div>
        <input type="text" class="form-control answer-text" placeholder="Answer text" required>
        <button type="button" class="btn btn-outline-danger remove-answer-btn" title="Remove answer">
            <i class="bi bi-x"></i>
        </button>
    </div>
</template>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let questionIndex = 0;

        document.addEventListener('DOMContentLoaded', function() {
            const lessonTypeSelect = document.getElementById('lessonTypeSelect');
            const quizEditor = document.getElementById('quizEditor');
            const addQuestionBtn = document.getElementById('addQuestionBtn');
            const questionsContainer = document.getElementById('questionsContainer');
            const emptyState = document.getElementById('emptyState');
            const lessonForm = document.getElementById('lessonForm');

            // Toggle quiz editor
            function toggleQuizEditor() {
                quizEditor.style.display = lessonTypeSelect.value === 'quiz' ? 'block' : 'none';
            }

            lessonTypeSelect.addEventListener('change', toggleQuizEditor);
            toggleQuizEditor();

            // Add question
            addQuestionBtn.addEventListener('click', function() {
                const template = document.getElementById('questionTemplate');
                const clone = template.content.cloneNode(true);
                const questionDiv = clone.querySelector('.question-item');

                questionIndex++;
                questionDiv.dataset.questionIndex = questionIndex;
                questionDiv.querySelector('.question-title').textContent = `Question ${questionIndex}`;

                // Add 2 default answers
                const answersContainer = questionDiv.querySelector('.answers-container');
                addAnswer(answersContainer, 0);
                addAnswer(answersContainer, 1);

                questionsContainer.appendChild(clone);
                emptyState.style.display = 'none';

                // Setup event listeners
                setupQuestionEvents(questionsContainer.lastElementChild);
            });

            // Add answer to a question
            function addAnswer(container, index) {
                if (container.children.length >= 5) {
                    alert('Maximum 5 answers per question');
                    return;
                }

                const template = document.getElementById('answerTemplate');
                const clone = template.content.cloneNode(true);
                const answerDiv = clone.querySelector('.answer-item');
                answerDiv.dataset.answerIndex = index;

                container.appendChild(clone);
                setupAnswerEvents(container.lastElementChild);
            }

            // Setup question events
            function setupQuestionEvents(questionDiv) {
                const removeBtn = questionDiv.querySelector('.remove-question-btn');
                const addAnswerBtn = questionDiv.querySelector('.add-answer-btn');
                const answersContainer = questionDiv.querySelector('.answers-container');
                const questionType = questionDiv.querySelector('.question-type');
                const answersSection = questionDiv.querySelector('.answers-section');

                // Remove question
                removeBtn.addEventListener('click', function() {
                    questionDiv.remove();
                    if (questionsContainer.children.length === 0) {
                        emptyState.style.display = 'block';
                    }
                    renumberQuestions();
                });

                // Add answer
                addAnswerBtn.addEventListener('click', function() {
                    const newIndex = answersContainer.children.length;
                    addAnswer(answersContainer, newIndex);
                });

                // Toggle answers visibility based on question type
                questionType.addEventListener('change', function() {
                    answersSection.style.display = this.value === 'multiple_choice' ? 'block' : 'none';
                });
            }

            // Setup answer events
            function setupAnswerEvents(answerDiv) {
                const removeBtn = answerDiv.querySelector('.remove-answer-btn');

                removeBtn.addEventListener('click', function() {
                    const container = answerDiv.parentElement;
                    if (container.children.length <= 2) {
                        alert('Minimum 2 answers required');
                        return;
                    }
                    answerDiv.remove();
                });
            }

            // Renumber questions
            function renumberQuestions() {
                const questions = questionsContainer.querySelectorAll('.question-item');
                questions.forEach((q, index) => {
                    q.querySelector('.question-title').textContent = `Question ${index + 1}`;
                    q.dataset.questionIndex = index + 1;
                });
            }

            // Validate and serialize quiz data before submit
            lessonForm.addEventListener('submit', function(e) {
                if (lessonTypeSelect.value !== 'quiz') return;

                const questions = questionsContainer.querySelectorAll('.question-item');
                if (questions.length === 0) {
                    alert('Please add at least one question');
                    e.preventDefault();
                    return;
                }

                const quizData = {
                    Questions: []
                };

                let isValid = true;

                questions.forEach((qDiv, qIndex) => {
                    const questionText = qDiv.querySelector('.question-text').value.trim();
                    const questionType = qDiv.querySelector('.question-type').value;
                    const points = parseInt(qDiv.querySelector('.question-points').value) || 10;
                    const explanation = qDiv.querySelector('.question-explanation').value.trim();

                    if (!questionText) {
                        alert(`Question ${qIndex + 1}: Text is required`);
                        isValid = false;
                        return;
                    }

                    const questionDto = {
                        QuestionText: questionText,
                        QuestionType: questionType,
                        QuestionOrder: qIndex + 1,
                        Points: points,
                        Explanation: explanation || null,
                        Answers: []
                    };

                    if (questionType === 'multiple_choice') {
                        const answers = qDiv.querySelectorAll('.answer-item');

                        if (answers.length < 2) {
                            alert(`Question ${qIndex + 1}: At least 2 answers required`);
                            isValid = false;
                            return;
                        }

                        let hasCorrect = false;

                        answers.forEach((aDiv, aIndex) => {
                            const answerText = aDiv.querySelector('.answer-text').value.trim();
                            const isCorrect = aDiv.querySelector('.answer-correct').checked;

                            if (!answerText) {
                                alert(`Question ${qIndex + 1}, Answer ${aIndex + 1}: Text is required`);
                                isValid = false;
                                return;
                            }

                            if (isCorrect) hasCorrect = true;

                            questionDto.Answers.push({
                                AnswerText: answerText,
                                IsCorrect: isCorrect,
                                AnswerOrder: aIndex + 1
                            });
                        });

                        if (!hasCorrect) {
                            alert(`Question ${qIndex + 1}: At least one correct answer required`);
                            isValid = false;
                            return;
                        }
                    }

                    quizData.Questions.push(questionDto);
                });

                if (!isValid) {
                    e.preventDefault();
                    return;
                }

                // Serialize to JSON and add to hidden input
                document.getElementById('quizDataInput').value = JSON.stringify(quizData);
            });
        });
    </script>

    <style>
        .question-item {
            border-left: 4px solid #ffc107;
        }

        .answer-item {
            transition: all 0.2s;
        }

            .answer-item:hover {
                background-color: #f8f9fa;
            }

        .form-check-input:checked {
            background-color: #28a745;
            border-color: #28a745;
        }
    </style>
}