@model DoAnChuyenNganh.Models.Course

@{
    ViewData["Title"] = "Create Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>Create New Course</h2>
            <hr />
        </div>
    </div>

    @* @if (TempData["ErrorMessage"] != null) *@
    @* { *@
    @*     <div class="alert alert-danger alert-dismissible fade show" role="alert"> *@
    @*         <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"] *@
    @*         <button type="button" class="btn-close" data-bs-dismiss="alert"></button> *@
    @*     </div> *@
    @* } *@

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @{
                    var hasModelErrors = !ViewData.ModelState.IsValid &&
                    ViewData.ModelState.Values.Any(v => v.Errors.Count > 0);

                    var tempError = TempData["ErrorMessage"] as string;
                }

                @if (hasModelErrors || !string.IsNullOrEmpty(tempError))
                {
                    <div class="alert alert-danger mb-3">
                        @if (!string.IsNullOrEmpty(tempError))
                        {
                            <div>@tempError</div>
                        }

                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }


                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label">Course Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter course title" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Slug" class="form-label">URL Slug</label>
                            <input asp-for="Slug" class="form-control" placeholder="course-url-slug (leave empty for auto-generate)" />
                            <small class="form-text text-muted">Optional: Friendly URL for the course</small>
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ShortDescription" class="form-label">Short Description</label>
                            <textarea asp-for="ShortDescription" class="form-control" rows="2"
                                      placeholder="Brief description (max 300 characters)" maxlength="300"></textarea>
                            <span asp-validation-for="ShortDescription" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Full Description</label>
                            <textarea asp-for="Description" class="form-control" rows="5"
                                      placeholder="Detailed course description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Course Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="SubjectId" class="form-label">Subject <span class="text-danger">*</span></label>
                                    <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId" required>
                                        <option value="">-- Select Subject --</option>
                                    </select>
                                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="GradeId" class="form-label">Grade Level <span class="text-danger">*</span></label>
                                    <select asp-for="GradeId" class="form-select" asp-items="ViewBag.GradeId" required>
                                        <option value="">-- Select Grade --</option>
                                    </select>
                                    <span asp-validation-for="GradeId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold text-success">Instructor</label>
                                <input type="text"
                                       class="form-control bg-light"
                                       value="@User.Identity.Name (@ViewData["CurrentUserFullName"])"
                                       disabled />
                                <small class="form-text text-muted mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    This course will be assigned to <strong>you</strong> as the instructor automatically.
                                </small>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="DifficultyLevel" class="form-label">Difficulty Level</label>
                                    <select asp-for="DifficultyLevel" class="form-select">
                                        <option value="">-- Select Difficulty --</option>
                                        <option value="1">1 - Beginner</option>
                                        <option value="2">2 - Elementary</option>
                                        <option value="3">3 - Intermediate</option>
                                        <option value="4">4 - Advanced</option>
                                        <option value="5">5 - Expert</option>
                                    </select>
                                    <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="EstimatedHours" class="form-label">Estimated Hours</label>
                                    <input asp-for="EstimatedHours" type="number" step="0.5" min="0" class="form-control"
                                           placeholder="e.g., 10.5" />
                                    <span asp-validation-for="EstimatedHours" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label">Price (VND)</label>
                                    <input asp-for="Price" type="number" step="1000" min="0" class="form-control"
                                           placeholder="0 for free course" value="0" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Course Thumbnail <span class="text-danger">*</span></label>

                            <div class="border rounded p-3 bg-light">
                                <!-- Input file upload -->
                                <input type="file" name="ThumbnailFile" id="thumbnailFile" class="form-control" accept="image/*" />
                                <small class="form-text text-muted d-block mt-2">
                                    <i class="bi bi-image"></i> Recommended size: 1280x720px | Max 5MB | JPG, PNG, GIF, WebP
                                </small>

                                <!-- Preview ảnh khi chọn file -->
                                <div id="thumbnailPreview" class="mt-3 text-center" style="display: none;">
                                    <p class="mb-2 text-muted"><strong>Preview:</strong></p>
                                    <img id="previewImg" src="" alt="Thumbnail preview" class="img-fluid rounded border" style="max-height: 300px;" />
                                </div>

                                <!-- Optional: Giữ trường ThumbnailUrl ẩn để hỗ trợ fallback (nếu cần) -->
                                <input asp-for="ThumbnailUrl" type="hidden" />
                            </div>

                            <span asp-validation-for="ThumbnailUrl" class="text-danger"></span>
                            @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string) && TempData["ErrorMessage"].ToString().Contains("thumbnail"))
                            {
                                <div class="text-danger mt-2">
                                    @TempData["ErrorMessage"]
                                </div>
                            }
                        </div>
                        <div class="form-check mt-3">
                            <input class="form-check-input" asp-for="IsPublished" />
                            <label class="form-check-label" asp-for="IsPublished">
                                <strong>Published</strong>
                                <small class="d-block text-muted">
                                    Make this course visible to students
                                </small>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-save"></i> Create Course
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            <strong>Title:</strong> Use clear, descriptive course titles
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            <strong>Description:</strong> Include learning objectives and prerequisites
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            <strong>Thumbnail:</strong> Use high-quality images (recommended: 1280x720px)
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            Course will be saved as <strong>draft</strong> by default
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            You can add lessons after creating the course
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
            document.addEventListener('DOMContentLoaded', function () {
            const thumbnailFileInput = document.getElementById('thumbnailFile');
            const previewContainer = document.getElementById('thumbnailPreview');
            const previewImg = document.getElementById('previewImg');

            if (thumbnailFileInput) {
                thumbnailFileInput.addEventListener('change', function (e) {
                    const file = e.target.files[0];

                    if (file) {
                        // Kiểm tra kích thước file (max 5MB)
                        if (file.size > 5 * 1024 * 1024) {
                            alert('File size must be less than 5MB');
                            thumbnailFileInput.value = '';
                            previewContainer.style.display = 'none';
                            return;
                        }

                        // Kiểm tra loại file
                        if (!file.type.startsWith('image/')) {
                            alert('Please select an image file');
                            thumbnailFileInput.value = '';
                            previewContainer.style.display = 'none';
                            return;
                        }

                        // Hiển thị preview
                        const reader = new FileReader();
                        reader.onload = function (event) {
                            previewImg.src = event.target.result;
                            previewContainer.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    } else {
                        previewContainer.style.display = 'none';
                    }
                });
            }

            // Auto slugify title (giữ nguyên script cũ của bạn)
            const titleInput = document.getElementById('Title');
            const slugInput = document.getElementById('Slug');

            if (titleInput && slugInput) {
                titleInput.addEventListener('input', function () {
                    const value = titleInput.value || '';
                    slugInput.value = slugify(value);
                });
            }

            function slugify(text) {
                return text
                    .toString()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .trim()
                    .replace(/[^a-z0-9]+/g, '-')
                    .replace(/^-+|-+$/g, '');
            }
        })

    </script>
}