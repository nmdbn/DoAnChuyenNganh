@model DoAnChuyenNganh.Models.Course

@{
    ViewData["Title"] = "Edit Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2><i class="bi bi-pencil-square"></i> Edit Course</h2>
            <p class="text-muted">Update course information and settings</p>
            <hr />
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="CourseId" />
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label">
                                Course Title <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control form-control-lg" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Slug" class="form-label">URL Slug</label>
                            <input asp-for="Slug" class="form-control" placeholder="course-url-slug" />
                            <small class="form-text text-muted">Friendly URL for the course (auto-generated if empty)</small>
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ShortDescription" class="form-label">Short Description</label>
                            <textarea asp-for="ShortDescription" class="form-control" rows="2"
                                      maxlength="300" placeholder="Brief description (max 300 characters)"></textarea>
                            <small class="form-text text-muted">
                                <span id="charCount">@(Model.ShortDescription?.Length ?? 0)</span>/300 characters
                            </small>
                            <span asp-validation-for="ShortDescription" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Full Description</label>
                            <textarea asp-for="Description" class="form-control" rows="6"
                                      placeholder="Detailed course description, learning objectives, prerequisites..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-gear"></i> Course Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="SubjectId" class="form-label">
                                        Subject <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId" required>
                                        <option value="">-- Select Subject --</option>
                                    </select>
                                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="GradeId" class="form-label">
                                        Grade Level <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="GradeId" class="form-select" asp-items="ViewBag.GradeId" required>
                                        <option value="">-- Select Grade --</option>
                                    </select>
                                    <span asp-validation-for="GradeId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="InstructorId" class="form-label">
                                        Instructor <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="InstructorId" class="form-select" asp-items="ViewBag.InstructorId" required>
                                        <option value="">-- Select Instructor --</option>
                                    </select>
                                    <span asp-validation-for="InstructorId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="DifficultyLevel" class="form-label">Difficulty Level</label>
                                    <select asp-for="DifficultyLevel" class="form-select">
                                        <option value="">-- Select Difficulty --</option>
                                        <option value="1">⭐ Level 1 - Beginner</option>
                                        <option value="2">⭐⭐ Level 2 - Elementary</option>
                                        <option value="3">⭐⭐⭐ Level 3 - Intermediate</option>
                                        <option value="4">⭐⭐⭐⭐ Level 4 - Advanced</option>
                                        <option value="5">⭐⭐⭐⭐⭐ Level 5 - Expert</option>
                                    </select>
                                    <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="EstimatedHours" class="form-label">
                                        <i class="bi bi-clock"></i> Estimated Hours
                                    </label>
                                    <input asp-for="EstimatedHours" type="number" step="0.5" min="0"
                                           class="form-control" placeholder="e.g., 10.5" />
                                    <small class="form-text text-muted">Total estimated learning time</small>
                                    <span asp-validation-for="EstimatedHours" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label">
                                        <i class="bi bi-tag"></i> Price (VND)
                                    </label>
                                    <input asp-for="Price" type="number" step="1000" min="0"
                                           class="form-control" placeholder="Enter 0 for free course" />
                                    <small class="form-text text-muted">Set to 0 for free course</small>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ThumbnailUrl" class="form-label">
                                <i class="bi bi-image"></i> Thumbnail URL
                            </label>
                            <input asp-for="ThumbnailUrl" class="form-control"
                                   placeholder="https://example.com/image.jpg" />
                            <small class="form-text text-muted">
                                Recommended size: 1280x720px (16:9 ratio)
                            </small>
                            <span asp-validation-for="ThumbnailUrl" class="text-danger"></span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                        {
                            <div class="mb-3">
                                <label class="form-label">Current Thumbnail:</label>
                                <div>
                                    <img src="@Model.ThumbnailUrl" alt="Course thumbnail"
                                         class="img-thumbnail" style="max-width: 300px;"
                                         onerror="this.src='https://via.placeholder.com/300x169?text=Invalid+Image'" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-broadcast"></i> Publishing Options</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-3">
                                    @* Khắc phục lỗi bằng HTML thuần: SỬ DỤNG name VÀ checked *@
                                    <input name="IsPublished"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="isPublishedSwitch"
                                           value="true"
                                    @(Model.IsPublished == true ? "checked" : "") />
                                    @* Thêm Hidden field để đảm bảo giá trị false được gửi khi checkbox không được check *@
                                    <input type="hidden" name="IsPublished" value="false" />

                                    <label class="form-check-label" for="isPublishedSwitch">
                                        <strong>Published</strong>
                                        <small class="d-block text-muted">
                                            Make this course visible to students
                                        </small>
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check form-switch mb-3">
                                    @* Khắc phục lỗi bằng HTML thuần: SỬ DỤNG name VÀ checked *@
                                    <input name="IsFeatured"
                                           class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="isFeaturedSwitch"
                                           value="true"
                                    @(Model.IsFeatured == true ? "checked" : "") />
                                    <input type="hidden" name="IsFeatured" value="false" />

                                    <label class="form-check-label" for="isFeaturedSwitch">
                                        <strong>Featured Course</strong>
                                        <small class="d-block text-muted">
                                            Display on homepage and featured sections
                                        </small>
                                    </label>
                                </div>
                            </div>
                        </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-between mb-4">
                    <div>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                    <div>
                        <a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-info btn-lg">
                            <i class="bi bi-eye"></i> Preview
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <div class="card mb-3 border-info">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Course Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-eye text-primary"></i> Total Views:</span>
                            <strong class="fs-5">@(Model.ViewCount?.ToString("N0") ?? "0")</strong>
                        </div>
                        <div class="progress" style="height: 5px;">
                            <div class="progress-bar bg-primary" role="progressbar"
                                 style="width: @(Math.Min((Model.ViewCount ?? 0) / 10, 100))%"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-people text-success"></i> Enrollments:</span>
                            <strong class="fs-5">@(Model.EnrollmentCount?.ToString("N0") ?? "0")</strong>
                        </div>
                        <div class="progress" style="height: 5px;">
                            <div class="progress-bar bg-success" role="progressbar"
                                 style="width: @(Math.Min((Model.EnrollmentCount ?? 0) / 5, 100))%"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-star-fill text-warning"></i> Average Rating:</span>
                            @if (Model.RatingCount > 0)
                            {
                                <strong class="fs-5">
                                    @Model.AverageRating?.ToString("0.00")
                                    <small class="text-muted">(@Model.RatingCount)</small>
                                </strong>
                            }
                            else
                            {
                                <span class="text-muted">No ratings yet</span>
                            }
                        </div>
                        @if (Model.RatingCount > 0)
                        {
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar bg-warning" role="progressbar"
                                     style="width: @((Model.AverageRating ?? 0) * 20)%"></div>
                            </div>
                        }
                    </div>

                    <hr />

                    <dl class="row mb-0 small">
                        <dt class="col-sm-6">Created:</dt>
                        <dd class="col-sm-6">@Model.CreatedAt?.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-6">Last Updated:</dt>
                        <dd class="col-sm-6">@Model.UpdatedAt?.ToString("dd/MM/yyyy")</dd>

                        @if (Model.PublishedAt != null)
                        {
                            <dt class="col-sm-6">Published:</dt>
                            <dd class="col-sm-6">@Model.PublishedAt?.ToString("dd/MM/yyyy")</dd>
                        }

                        <dt class="col-sm-6">Status:</dt>
                        <dd class="col-sm-6">
                            @if (Model.IsPublished == true)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Draft</span>
                            }

                            @if (Model.IsFeatured == true)
                            {
                                <span class="badge bg-primary">Featured</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-outline-primary">
                            <i class="bi bi-book"></i> Manage Lessons
                        </a>
                        <a href="#" class="btn btn-outline-info">
                            <i class="bi bi-file-earmark"></i> Course Materials
                        </a>
                        <a href="#" class="btn btn-outline-success">
                            <i class="bi bi-people"></i> View Students
                        </a>
                        <a href="#" class="btn btn-outline-secondary">
                            <i class="bi bi-star"></i> Reviews & Ratings
                        </a>
                        <hr />
                        <a asp-action="Delete" asp-route-id="@Model.CourseId"
                           class="btn btn-outline-danger"
                           onclick="return confirm('Are you sure you want to delete this course?')">
                            <i class="bi bi-trash"></i> Delete Course
                        </a>
                    </div>
                </div>
            </div>

            <div class="card border-secondary">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-lightbulb"></i> Tips</h5>
                </div>
                <div class="card-body small">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Keep titles clear and descriptive
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Use high-quality thumbnails (1280x720px)
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Add detailed descriptions with objectives
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Set realistic estimated hours
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            Unpublish to make changes without affecting students
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Character counter for short description
        document.getElementById('ShortDescription')?.addEventListener('input', function() {
            document.getElementById('charCount').textContent = this.value.length;
        });

        // Auto-generate slug from title if slug is empty
        document.getElementById('Title')?.addEventListener('input', function() {
            const slugInput = document.getElementById('Slug');
            if (slugInput && !slugInput.value) {
                let slug = this.value
                    .toLowerCase()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd')
                    .replace(/[^a-z0-9\s-]/g, '')
                    .trim()
                    .replace(/\s+/g, '-');

                slugInput.value = slug;
            }
        });

        // Preview thumbnail (optional, placeholder code)
        document.getElementById('ThumbnailUrl')?.addEventListener('change', function() {
            // Optional: Add thumbnail preview functionality
            const url = this.value;
            const previewImg = document.querySelector('.img-thumbnail');
            if (previewImg) {
                previewImg.src = url;
            }
        });
    </script>
}