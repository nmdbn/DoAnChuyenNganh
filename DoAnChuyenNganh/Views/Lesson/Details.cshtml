@model DoAnChuyenNganh.Models.Lesson

@{
    ViewData["Title"] = "Lesson details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <!-- HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">Lesson details</h2>
            <p class="text-muted mb-0">View full information of the lesson</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.LessonId" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to list
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-body">
                    <!-- TITLE + META -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="mb-1">@Model.Title</h4>
                            <div class="text-muted small">
                                Lesson #@Model.LessonOrder
                                @if (!string.IsNullOrWhiteSpace(Model.LessonType))
                                {
                                    <span class="mx-1">•</span>
                                    <span>@Model.LessonType</span>
                                }
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="mb-1">
                                @if (Model.IsPublished == true)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </div>
                            <div>
                                @if (Model.IsPreviewable == true)
                                {
                                    <span class="badge bg-info text-dark">Preview enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Preview disabled</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CONTENT -->
                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted small mb-2">Content</h6>
                        @if (string.IsNullOrWhiteSpace(Model.Content))
                        {
                            <p class="text-muted fst-italic mb-0">No content provided.</p>
                        }
                        else
                        {
                            <p class="mb-0">@Model.Content</p>
                        }
                    </div>

                    <!-- VIDEO INFO -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <h6 class="text-uppercase text-muted small mb-2">Video URL</h6>
                            @if (string.IsNullOrWhiteSpace(Model.VideoUrl))
                            {
                                <p class="text-muted fst-italic mb-0">No video attached.</p>
                            }
                            else
                            {
                                <p class="mb-0">
                                    <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer">
                                        @Model.VideoUrl
                                    </a>
                                </p>
                            }
                        </div>
                        <div class="col-md-4">
                            <h6 class="text-uppercase text-muted small mb-2">Video duration</h6>
                            @if (Model.VideoDuration.HasValue && Model.VideoDuration.Value > 0)
                            {
                                <p class="mb-0">@Model.VideoDuration.Value seconds</p>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">Not specified.</p>
                            }
                        </div>
                    </div>

                    <!-- COURSE & RELATIONS -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted small mb-2">Course</h6>
                            @if (Model.Course != null)
                            {
                                <p class="mb-0">
                                    @* Replace CourseId with CourseName if available *@
                                    ID: @Model.Course.CourseId
                                </p>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">No course linked.</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted small mb-2">Lesson ID</h6>
                            <p class="mb-0">@Model.LessonId</p>
                        </div>
                    </div>

                    <!-- AUDIT INFO -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted small mb-2">Created at</h6>
                            <p class="mb-1">@Html.DisplayFor(m => m.CreatedAt)</p>

                            <h6 class="text-uppercase text-muted small mb-2">Created by</h6>
                            @if (Model.CreatedByNavigation != null)
                            {
                                <p class="mb-0">
                                    User ID: @Model.CreatedByNavigation.UserId
                                </p>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">Unknown.</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted small mb-2">Last updated at</h6>
                            <p class="mb-1">@Html.DisplayFor(m => m.UpdatedAt)</p>

                            <h6 class="text-uppercase text-muted small mb-2">Last updated by</h6>
                            @if (Model.UpdatedByNavigation != null)
                            {
                                <p class="mb-0">
                                    User ID: @Model.UpdatedByNavigation.UserId
                                </p>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">Unknown.</p>
                            }
                        </div>
                    </div>

                    <!-- ACTIONS BOTTOM -->
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Back to list
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model?.LessonId" class="btn btn-primary">
                            Edit lesson
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>