@model DoAnChuyenNganh.Models.Lesson

@{
    ViewData["Title"] = "Edit lesson";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <!-- HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">Edit lesson</h2>
            <p class="text-muted mb-0">Update lesson information</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to list
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="LessonId" />

                        <!-- BASIC INFO -->
                        <h5 class="mb-3">Basic information</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CourseId" class="form-label">Course</label>
                                <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId">
                                    <option value="">-- Select course --</option>
                                </select>
                                <span asp-validation-for="CourseId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LessonOrder" class="form-label">Lesson order</label>
                                <input asp-for="LessonOrder" class="form-control" type="number" />
                                <span asp-validation-for="LessonOrder" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Enter lesson title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label">Content</label>
                            <textarea asp-for="Content" class="form-control" rows="4" placeholder="Lesson content or description"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <!-- TYPE & VIDEO -->
                        <h5 class="mb-3 mt-4">Lesson & video</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="LessonType" class="form-label">Lesson type</label>
                                <select asp-for="LessonType" class="form-select">
                                    <option value="">-- Select Type --</option>
                                    <option value="text">Text</option>
                                    <option value="video">Video</option>
                                    <option value="quiz">Quiz</option>
                                    <option value="assignment">Assignment</option>
                                </select>
                                <span asp-validation-for="LessonType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VideoDuration" class="form-label">Video duration (seconds)</label>
                                <input asp-for="VideoDuration" class="form-control" type="number" min="0" />
                                <span asp-validation-for="VideoDuration" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VideoUrl" class="form-label">Video URL</label>
                            <input asp-for="VideoUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="VideoUrl" class="text-danger"></span>
                        </div>

                        <!-- FLAGS -->
                        <h5 class="mb-3 mt-4">Visibility & access</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="IsPreviewable"
                                           name="IsPreviewable"
                                           value="true"
                                    @(Model?.IsPreviewable == true ? "checked" : "") />
                                    <input type="hidden" name="IsPreviewable" value="false" />
                                    <label class="form-check-label" for="IsPreviewable">Allow preview</label>
                                </div>
                                <span asp-validation-for="IsPreviewable" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="IsPublished"
                                           name="IsPublished"
                                           value="true"
                                    @(Model?.IsPublished == true ? "checked" : "") />
                                    <input type="hidden" name="IsPublished" value="false" />
                                    <label class="form-check-label" for="IsPublished">Published</label>
                                </div>
                                <span asp-validation-for="IsPublished" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- AUDIT INFO (Read-only display) -->
                        <h5 class="mb-3 mt-4">Audit information</h5>
                        <div class="alert alert-light">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <strong>Created at:</strong><br />
                                    <span class="text-muted">@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Created by:</strong><br />
                                    <span class="text-muted">@Model.CreatedByNavigation?.Username</span>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <small class="text-info">
                                        <i class="bi bi-info-circle"></i>
                                        Last update information will be automatically recorded when you save changes.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}