@model DoAnChuyenNganh.Models.Subject

@{
    ViewData["Title"] = "Edit Subject";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-3">
    <!-- HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-pencil-square"></i> Edit Subject
            </h2>
            <p class="text-muted mb-0">Update subject information</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Subject Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="SubjectId" />

                        <!-- BASIC INFO -->
                        <h5 class="section-header">
                            <i class="bi bi-info-circle"></i> Basic Information
                        </h5>
                        <div class="section-divider"></div>

                        <div class="mb-3">
                            <label asp-for="SubjectName" class="form-label fw-semibold">
                                Subject Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SubjectName" class="form-control form-control-lg"
                                   placeholder="Enter subject name" />
                            <span asp-validation-for="SubjectName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SubjectCode" class="form-label fw-semibold">
                                Subject Code <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SubjectCode" class="form-control"
                                   placeholder="Enter unique subject code"
                                   style="font-family: 'Courier New', monospace;" />
                            <small class="form-text text-muted">This code must be unique in the system</small>
                            <span asp-validation-for="SubjectCode" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Enter subject description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- ICON -->
                        <h5 class="section-header">
                            <i class="bi bi-image"></i> Icon & Visual
                        </h5>
                        <div class="section-divider"></div>

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <label asp-for="IconUrl" class="form-label fw-semibold">Icon URL</label>
                                <input asp-for="IconUrl" class="form-control"
                                       placeholder="https://example.com/icon.png"
                                       id="iconUrlInput" />
                                <small class="form-text text-muted">Enter URL for subject icon/image</small>
                                <span asp-validation-for="IconUrl" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Preview</label>
                                <div class="icon-preview-box" id="iconPreview">
                                    @if (!string.IsNullOrEmpty(Model?.IconUrl))
                                    {
                                        <img src="@Model.IconUrl" alt="Icon" class="icon-image"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                        <div style="display: none;">
                                            <i class="bi bi-image" style="font-size: 2rem; color: #ccc;"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <i class="bi bi-image" style="font-size: 2rem; color: #ccc;"></i>
                                        <small class="d-block mt-2 text-muted">No icon</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- STATUS - ĐÃ SỬA: Đảo thứ tự input -->
                        <h5 class="section-header">
                            <i class="bi bi-toggle-on"></i> Status
                        </h5>
                        <div class="section-divider"></div>

                        <div class="mb-4">
                            <div class="form-check form-switch form-switch-lg">
                                <!-- ✅ ĐẶT HIDDEN INPUT TRƯỚC CHECKBOX -->
                                <input type="hidden" name="IsActive" value="false" />
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="IsActive"
                                       name="IsActive"
                                       value="true"
                                @(Model?.IsActive == true ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="IsActive">
                                    Active Subject
                                    <small class="d-block text-muted fw-normal">
                                        @if (Model?.IsActive == true)
                                        {
                                            <span class="text-success">✓ This subject is currently active</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning">⚠ This subject is currently inactive</span>
                                        }
                                    </small>
                                </label>
                            </div>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>

                        <!-- AUDIT INFO -->
                        <h5 class="section-header">
                            <i class="bi bi-clock-history"></i> Audit Information
                        </h5>
                        <div class="section-divider"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Created At</label>
                                <input type="text" class="form-control-plaintext"
                                       value="@(Model?.CreatedAt?.ToString("MMMM dd, yyyy 'at' HH:mm") ?? "N/A")" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Last Updated</label>
                                <input type="text" class="form-control-plaintext"
                                       value="@(Model?.UpdatedAt?.ToString("MMMM dd, yyyy 'at' HH:mm") ?? "Never")" readonly />
                            </div>
                        </div>

                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="UpdatedAt" value="@DateTime.Now" />

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Note:</strong> Update timestamp will be automatically recorded when you save changes.
                        </div>

                        <!-- ACTIONS -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ADDITIONAL INFO CARD -->
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-body">
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-lightbulb"></i> Quick Tips
                    </h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check2 text-success"></i>
                            Changes are saved immediately after clicking "Save Changes"
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check2 text-success"></i>
                            Subject code must remain unique across all subjects
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check2 text-success"></i>
                            Inactive subjects won't appear in course creation forms
                        </li>
                        <li>
                            <i class="bi bi-check2 text-success"></i>
                            Icon preview updates automatically when you enter a valid URL
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Icon preview functionality
            $('#iconUrlInput').on('input', function() {
                const url = $(this).val().trim();
                const preview = $('#iconPreview');

                if (url) {
                    preview.html(`
                        <img src="${url}" alt="Icon Preview" class="icon-image"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <div style="display: none;">
                            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 2rem;"></i>
                            <small class="d-block mt-2 text-danger">Invalid URL</small>
                        </div>
                    `);
                } else {
                    preview.html(`
                        <i class="bi bi-image" style="font-size: 2rem; color: #ccc;"></i>
                        <small class="d-block mt-2 text-muted">No icon</small>
                    `);
                }
            });

            // Status switch feedback
            $('#IsActive').on('change', function() {
                const isActive = $(this).is(':checked');
                const label = $(this).next('label').find('small');

                if (isActive) {
                    label.html('<span class="text-success">✓ This subject is currently active</span>');
                } else {
                    label.html('<span class="text-warning">⚠ This subject is currently inactive</span>');
                }
            });
        });
    </script>
}

<style>
    .section-header {
        color: #374151;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .section-divider {
        height: 2px;
        background: linear-gradient(to right, #667eea, #764ba2, transparent);
        margin-bottom: 1rem;
    }

    .form-label {
        color: #374151;
    }

    .fw-semibold {
        font-weight: 600;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
        border: 1px solid #d1d5db;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
            border-color: #667eea;
        }

    .form-switch-lg .form-check-input {
        width: 3rem;
        height: 1.5rem;
    }

    .icon-preview-box {
        border: 2px dashed #ddd;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        min-height: 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f9fafb;
        transition: all 0.3s ease;
    }

        .icon-preview-box:hover {
            border-color: #667eea;
            background: #f3f4f6;
        }

    .icon-image {
        max-width: 100%;
        max-height: 80px;
        object-fit: contain;
        border-radius: 4px;
    }

    .card {
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .shadow-sm {
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08) !important;
    }

    .alert {
        border-radius: 10px;
    }

    .bg-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        border: none;
    }

    (max-width: 768px) {
        .btn-lg

    {
        width: 100%;
        margin-bottom: 10px;
    }

    .d-flex.gap-2 {
        flex-direction: column;
    }

    }
</style>