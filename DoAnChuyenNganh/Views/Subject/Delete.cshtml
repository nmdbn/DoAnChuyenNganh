@model DoAnChuyenNganh.Models.Subject

@{
    ViewData["Title"] = "Delete Subject";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Helper functions
    string DateTimeOrDash(DateTime? d) => d.HasValue ? d.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    string TextOrDash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s!;
}

<div class="container py-3">
    <!-- HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1 text-danger">
                <i class="bi bi-trash"></i> Delete Subject
            </h2>
            <div class="text-muted">
                Are you sure you want to delete
                <strong>@Model.SubjectName</strong> (Code: <code>@Model.SubjectCode</code>)?
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <!-- WARNING ALERT -->
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-exclamation-triangle-fill fs-2"></i>
            <div>
                <h5 class="alert-heading mb-2">Warning: This action cannot be undone!</h5>
                <p class="mb-1">
                    Deleting this subject will permanently remove it from the system.
                </p>
                <p class="mb-0">
                    <strong>Note:</strong> Related data (courses, lessons, enrollments) may be affected depending on your backend configuration.
                </p>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <!-- SUBJECT DETAILS CARD -->
    <div class="card border-danger mb-3">
        <div class="card-header bg-danger bg-opacity-10 border-danger">
            <h5 class="mb-0 text-danger">
                <i class="bi bi-info-circle"></i> Subject Information
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <!-- LEFT: ICON & BASIC INFO -->
                <div class="col-md-5">
                    <div class="d-flex align-items-start gap-3">
                        <div class="subject-icon-display">
                            @if (!string.IsNullOrEmpty(Model.IconUrl))
                            {
                                <img src="@Model.IconUrl" alt="@Model.SubjectName" class="icon-image"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="icon-placeholder" style="display: none;">
                                    @Model.SubjectName.Substring(0, 1).ToUpper()
                                </div>
                            }
                            else
                            {
                                <div class="icon-placeholder">
                                    @Model.SubjectName.Substring(0, 1).ToUpper()
                                </div>
                            }
                        </div>
                        <div>
                            <h4 class="mb-2">@Model.SubjectName</h4>
                            <div class="mb-2">
                                <span class="badge-code">@Model.SubjectCode</span>
                            </div>
                            <div class="text-muted small">
                                @if (Model.IsActive == true)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle"></i> Inactive
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="mt-3">
                            <div class="text-muted small mb-1">Description:</div>
                            <div class="description-preview">
                                @Model.Description
                            </div>
                        </div>
                    }
                </div>

                <!-- RIGHT: DETAILED INFO -->
                <div class="col-md-7">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Subject Name</dt>
                        <dd class="col-sm-7">@TextOrDash(Model.SubjectName)</dd>

                        <dt class="col-sm-5">Subject Code</dt>
                        <dd class="col-sm-7">
                            <code>@Model.SubjectCode</code>
                        </dd>

                        <dt class="col-sm-5">Icon URL</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(Model.IconUrl))
                            {
                                <a href="@Model.IconUrl" target="_blank" class="text-truncate d-inline-block" style="max-width: 250px;">
                                    @Model.IconUrl
                                </a>
                            }
                            else
                            {
                                @("-")
                            }
                        </dd>

                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7">
                            @if (Model.IsActive == true)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary">
                                    Inactive
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-5">Created At</dt>
                        <dd class="col-sm-7">@DateTimeOrDash(Model.CreatedAt)</dd>

                        <dt class="col-sm-5">Updated At</dt>
                        <dd class="col-sm-7">@DateTimeOrDash(Model.UpdatedAt)</dd>

                        <dt class="col-sm-5">Subject ID</dt>
                        <dd class="col-sm-7">
                            <code class="text-muted">@Model.SubjectId</code>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- CONFIRMATION CARD -->
    <div class="card border-warning">
        <div class="card-header bg-warning bg-opacity-10 border-warning">
            <h5 class="mb-0 text-warning">
                <i class="bi bi-shield-exclamation"></i> Confirmation Required
            </h5>
        </div>
        <div class="card-body">
            <p class="mb-3">
                Please confirm that you understand the consequences of this action:
            </p>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="confirmUnderstand">
                <label class="form-check-label" for="confirmUnderstand">
                    I understand this action is permanent and cannot be undone
                </label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="confirmAware">
                <label class="form-check-label" for="confirmAware">
                    I am aware that related data may be affected
                </label>
            </div>

            <form asp-action="Delete" id="deleteForm">
                <input type="hidden" asp-for="SubjectId" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger btn-lg" id="deleteButton" disabled>
                        <i class="bi bi-trash"></i> Delete Subject
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ADDITIONAL INFO -->
    <div class="alert alert-info mt-3">
        <i class="bi bi-info-circle"></i>
        <strong>Tip:</strong> If you want to temporarily disable this subject instead of deleting it,
        you can set it to "Inactive" status from the <a asp-action="Edit" asp-route-id="@Model.SubjectId">Edit page</a>.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Enable delete button only when both checkboxes are checked
            $('#confirmUnderstand, #confirmAware').on('change', function() {
                const allChecked = $('#confirmUnderstand').is(':checked') &&
                                  $('#confirmAware').is(':checked');
                $('#deleteButton').prop('disabled', !allChecked);
            });

            // Confirm before submit
            $('#deleteForm').on('submit', function(e) {
                if (!confirm('Are you absolutely sure you want to delete this subject? This action CANNOT be undone!')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}

<style>
    .subject-icon-display {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        overflow: hidden;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .icon-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .icon-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 2rem;
    }

    .badge-code {
        background: #dbeafe;
        color: #1e40af;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        font-family: 'Courier New', monospace;
    }

    .description-preview {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 0.75rem;
        font-size: 0.9rem;
        line-height: 1.5;
        max-height: 100px;
        overflow-y: auto;
    }

    .card {
        border-radius: 10px;
    }

    .alert {
        border-radius: 10px;
    }

    dt {
        font-weight: 600;
        color: #6b7280;
    }

    dd {
        color: #1f2937;
    }

    .form-check-label {
        font-weight: 500;
    }

    .btn-danger:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>