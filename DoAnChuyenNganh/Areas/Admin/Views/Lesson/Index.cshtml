@model IEnumerable<DoAnChuyenNganh.Models.Lesson>

@{
    ViewData["Title"] = "Quản lý bài học";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h1 class="mt-4">Danh sách bài học</h1>
            <p class="text-muted">Quản lý nội dung chi tiết của các khóa học.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i> Thêm bài học mới
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <div class="row">
                <div class="col-md-6 d-flex align-items-center">
                    <i class="bi bi-collection-play me-2"></i> <strong>Dữ liệu bài học</strong>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-nowrap align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4" style="width: 35%;">Bài học / Khóa học</th>
                            <th>Thứ tự & Loại</th>
                            <th>Video / Thời lượng</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark fs-6">@item.Title</div>
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-journal-bookmark me-1"></i> 
                                        Thuộc: <span class="text-primary">@(item.Course?.Title ?? "Chưa gán khóa học")</span>
                                    </div>
                                </td>
                                
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-light text-dark border me-2">
                                            Bài số: @item.LessonOrder
                                        </span>
                                        <span class="text-muted small">
                                            @if(item.LessonType == "Video") 
                                            { 
                                                <i class="bi bi-camera-video-fill text-danger me-1"></i> <span>Video</span>
                                            } 
                                            else 
                                            { 
                                                <i class="bi bi-file-text-fill text-info me-1"></i> <span>Tài liệu</span>
                                            }
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.VideoUrl))
                                    {
                                        <a href="@item.VideoUrl" target="_blank" class="btn btn-sm btn-outline-secondary border-0" title="Mở link video">
                                            <i class="bi bi-link-45deg fs-5"></i> Link
                                        </a>
                                        <span class="ms-2 small text-muted">
                                            <i class="bi bi-clock"></i> @(item.VideoDuration)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small ms-2">--</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsPublished == true)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Hiện</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">Ẩn</span>
                                    }

                                    @if (item.IsPreviewable == true)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill ms-1">
                                            <i class="bi bi-eye"></i> Học thử
                                        </span>
                                    }
                                </td>

                                <td class="text-muted small">
                                    @item.CreatedAt?.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.LessonId" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.LessonId" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.LessonId" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3">
            <small class="text-muted">Hiển thị @Model.Count() bài học</small>
        </div>
    </div>
</div>