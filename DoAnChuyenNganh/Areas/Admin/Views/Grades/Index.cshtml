@model IEnumerable<DoAnChuyenNganh.Models.Grade>

@{
    ViewData["Title"] = "Quản lý Khối lớp";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h1 class="mt-4">Danh mục Khối lớp</h1>
            <p class="text-muted">Quản lý các cấp độ học và phân loại trình độ.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i> Thêm khối lớp
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <div class="row">
                <div class="col-md-6 d-flex align-items-center">
                    <i class="bi bi-bar-chart-steps me-2"></i> <strong>Danh sách cấp độ</strong>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-nowrap align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="ps-4" style="width: 300px;">Cấp độ / Tên khối</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold border border-primary border-opacity-25"
                                             style="width: 40px; height: 40px; flex-shrink: 0;"
                                             title="Level @item.GradeLevel">
                                            @(item.GradeLevel)
                                        </div>

                                        <div class="ms-3">
                                            <div class="fw-bold text-dark fs-6">@item.GradeName</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="text-muted small text-wrap" style="max-width: 400px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(item.Description ?? "Chưa có mô tả")
                                    </div>
                                </td>

                                <td>
                                    @if (item.IsActive == true)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">
                                            Tạm ngưng
                                        </span>
                                    }
                                </td>

                                <td class="text-muted small">
                                    <i class="bi bi-clock me-1"></i> @item.CreatedAt?.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.GradeId" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.GradeId" class="btn btn-sm btn-outline-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.GradeId" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3">
            <small class="text-muted">Tổng số: <strong>@Model.Count()</strong> khối lớp</small>
        </div>
    </div>
</div>