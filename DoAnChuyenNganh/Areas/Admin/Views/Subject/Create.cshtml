@model DoAnChuyenNganh.Models.Subject

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>
                <i class="bi bi-plus-circle"></i> Create New Subject
            </h2>
            <p class="text-muted">Add a new subject to the system</p>
        </div>
        <div class="col-md-4 text-md-end text-start">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- LEFT: FORM -->
        <div class="col-md-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Subject Information</h5>
                    </div>
                    <div class="card-body">
                        <!-- BASIC INFO -->
                        <h6 class="section-title">Basic Information</h6>
                        <hr class="mt-1" />

                        <div class="form-group mb-3">
                            <label asp-for="SubjectName" class="form-label">
                                Subject Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SubjectName" class="form-control form-control-lg"
                                   placeholder="Enter subject name (e.g., Mathematics, Physics)" />
                            <span asp-validation-for="SubjectName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SubjectCode" class="form-label">
                                Subject Code <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SubjectCode" class="form-control"
                                   placeholder="Enter unique code (e.g., MATH101, PHY201)"
                                   style="font-family: 'Courier New', monospace;" />
                            <small class="form-text text-muted">This code must be unique in the system</small>
                            <span asp-validation-for="SubjectCode" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Describe the subject content, objectives, or notes..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- ICON & STATUS -->
                        <h6 class="section-title">Icon & Status</h6>
                        <hr class="mt-1" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group mb-3">
                                    <label asp-for="IconUrl" class="form-label">Icon URL</label>
                                    <input asp-for="IconUrl" class="form-control"
                                           placeholder="https://example.com/icon.png"
                                           id="iconUrlInput" />
                                    <small class="form-text text-muted">Enter URL for subject icon/image</small>
                                    <span asp-validation-for="IconUrl" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label d-block">Preview</label>
                                <div class="icon-preview" id="iconPreview">
                                    <i class="bi bi-image" style="font-size: 2rem; color: #ccc;"></i>
                                    <small class="d-block mt-2 text-muted">No icon</small>
                                </div>
                            </div>
                        </div>

                        <!-- ĐÃ SỬA: Đảo thứ tự input -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check form-switch form-switch-lg">
                                    <!-- ✅ ĐẶT HIDDEN INPUT TRƯỚC CHECKBOX -->
                                    <input type="hidden" name="IsActive" value="false" />
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="IsActive"
                                           name="IsActive"
                                           value="true"
                                           checked />
                                    <label class="form-check-label" for="IsActive">
                                        <strong>Active Subject</strong>
                                        <small class="d-block text-muted">Subject will be available in the system</small>
                                    </label>
                                </div>
                                <span asp-validation-for="IsActive" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Note:</strong> Creation date and time will be automatically recorded.
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-save"></i> Create Subject
                    </button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- RIGHT: TIPS -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-lightbulb"></i> Tips
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            <strong>Name:</strong> Use clear, standard subject names
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            <strong>Code:</strong> Use uppercase letters and numbers (e.g., MATH101)
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            <strong>Description:</strong> Include key topics and learning outcomes
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-info-circle text-primary"></i>
                            <strong>Icon:</strong> Use relevant icons to make subjects easily recognizable
                        </li>
                        <li>
                            <i class="bi bi-info-circle text-primary"></i>
                            <strong>Status:</strong> Uncheck "Active" to create as draft
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-question-circle"></i> Examples
                    </h5>
                </div>
                <div class="card-body">
                    <div class="example-item">
                        <strong>Mathematics</strong>
                        <div class="text-muted small">Code: MATH101</div>
                    </div>
                    <hr />
                    <div class="example-item">
                        <strong>English Literature</strong>
                        <div class="text-muted small">Code: ENG201</div>
                    </div>
                    <hr />
                    <div class="example-item">
                        <strong>Computer Science</strong>
                        <div class="text-muted small">Code: CS301</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Icon preview functionality
            $('#iconUrlInput').on('input', function() {
                const url = $(this).val().trim();
                const preview = $('#iconPreview');

                if (url) {
                    preview.html(`
                        <img src="${url}" alt="Icon Preview"
                             style="max-width: 100%; max-height: 80px; object-fit: contain;"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                        <div style="display: none;">
                            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 2rem;"></i>
                            <small class="d-block mt-2 text-danger">Invalid URL</small>
                        </div>
                    `);
                } else {
                    preview.html(`
                        <i class="bi bi-image" style="font-size: 2rem; color: #ccc;"></i>
                        <small class="d-block mt-2 text-muted">No icon</small>
                    `);
                }
            });
        });
    </script>
}

<style>
    .section-title {
        font-weight: 600;
        color: #374151;
        margin-top: 5px;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
            border-color: #667eea;
        }

    .form-switch-lg .form-check-input {
        width: 3rem;
        height: 1.5rem;
    }

    .icon-preview {
        border: 2px dashed #ddd;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        min-height: 100px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f9fafb;
    }

    .example-item {
        padding: 5px 0;
    }

    .alert-danger {
        border-radius: 10px;
    }

    (max-width: 768px) {
        .btn-lg

    {
        width: 100%;
        margin-bottom: 10px;
    }

    .d-flex.gap-2 {
        flex-direction: column;
    }

    }
</style>